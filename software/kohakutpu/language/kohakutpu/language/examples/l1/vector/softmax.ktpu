# Row softmax over 128 columns in base 2, 1024 rows on two cores:
# s = x log2 e, p = 2^(s - max s), y = p / sum p.
target ktpu.v9

# Two stages over 8-row tiles, software-pipelined: a step runs stage A of tile
# k (unpack, scale, row max) beside stage B of tile k-1, still in registers
# (EXP2D, row sum, 1/sum, scale, out). B's sum chain waits while A's
# reductions run, A's max chain while B scales. Tile parity j's rows are
# v{8j}..v{8j+7} and its statistics v{22+7j} (chunk 0 max, 1 sum, 2 1/sum);
# A reduces through v16..v19, v20, v21, B through v23..v26, v27, v28. Buffers:
# x l1[64j], out l1[256 + 64j]; m0, m1 mark x(j) filled. The last step's A
# runs on the fill past the end, and its tile is never written.
image softmax_pipe(passes, x, y)
    desc a0 = x walk=(32, 64)
    desc a1 = y walk=(32, 64)
    ainc a0 += 2K
    ainc a1 += 2K
    seti s0 = 1.4426950408889634
    vfill a0 -> l1[0] rel
    vmark m0 on=fill
    vfill a0 -> l1[64] rel
    vmark m1 on=fill
    expand unpack_x(0)
    for r in 0..8
        expand scale(0, r)
    for i in 0..8
        expand red1(vmax, 0, 16, i)
    for i in 0..8
        expand red2(vmax, 16, i)
    for r in 0..8
        expand red3(vmax, 16, 20, r)
    for s in 0..4
        expand mstep(vmax, 20, 21, 22, 0, s)
    seti s5 = passes
    loop s5
        expand step(1)
        expand step(0)
    halt

# A on parity j beside B on parity 1 - j.
macro step(j)
    expand unpack_x(j)
    expand scale(j, 0)
    expand scale(j, 1)
    for r in 0..8
        vexp2d v{8 - 8*j + r}, v{8 - 8*j + r}, bcast(v{29 - 7*j}[0], lane=r, sh=3)
        when r < 6
            expand scale(j, r + 2)
    for i in 0..8
        expand red1(vadd, 8 - 8*j, 23, i)
    for i in 0..8
        expand red2(vadd, 23, i)
    for r in 0..8
        expand red3(vadd, 23, 27, r)
    expand mstep(vadd, 27, 28, 29 - 7*j, 1, 0)
    for i in 0..4
        expand red1(vmax, 8*j, 16, i)
    expand mstep(vadd, 27, 28, 29 - 7*j, 1, 1)
    for i in 4..8
        expand red1(vmax, 8*j, 16, i)
    expand mstep(vadd, 27, 28, 29 - 7*j, 1, 2)
    for i in 0..8
        expand red2(vmax, 16, i)
    expand mstep(vadd, 27, 28, 29 - 7*j, 1, 3)
    for r in 0..8
        expand red3(vmax, 16, 20, r)
    vinv v{29 - 7*j}[2:], v{29 - 7*j}[1:] vl=16
    expand mstep(vmax, 20, 21, 22 + 7*j, 0, 0)
    vsync pack on=drain slack=1                 # out(1-j) drained two tiles back
    for r in 0..8
        vmul v{8 - 8*j + r}, v{8 - 8*j + r}, bcast(v{29 - 7*j}[2], lane=r, sh=3)
        vpack v{8 - 8*j + r} -> l1[320 - 64*j + 8*r] f16
        when r == 1
            expand mstep(vmax, 20, 21, 22 + 7*j, 0, 1)
        when r == 3
            expand mstep(vmax, 20, 21, 22 + 7*j, 0, 2)
        when r == 5
            expand mstep(vmax, 20, 21, 22 + 7*j, 0, 3)
    vsync drain on=pack
    vdrain a1 <- l1[320 - 64*j] rel

# Tile parity j's rows in, and the next tile's fill into its buffer.
macro unpack_x(j)
    vsync unpack mark=m{j}
    for r in 0..8
        vunpk v{8*j + r} <- l1[64*j + 8*r] f16
    vsync fill on=unpack
    vfill a0 -> l1[64*j] rel
    vmark m{j} on=fill

macro scale(j, r)
    vmul v{8*j + r}, v{8*j + r}, s0

# One 8-row reduction level i of `op`: rows from register x, temporaries t,
# partials g; `mstep` s of the 15-op merge into chunk dch of d.
macro red1(op, x, t, i)
    op v{t + i%4}[4*(i/4):], v{x + 2*(i%4) + i/4}[0:], v{x + 2*(i%4) + i/4}[4:] vl=64

macro red2(op, t, i)
    op v{t + i%4}[4*(i/4):], v{t + i%4}[4*(i/4):], v{t + i%4}[4*(i/4) + 2:] vl=32

macro red3(op, t, g, r)
    op v{g}[r:], v{t + r/2}[4*(r%2):], v{t + r/2}[4*(r%2) + 1:] vl=16

macro mstep(op, g, m, d, dch, s)
    when s == 0
        op v{m}, v{g}, merge(v{g}, 8)
    when s == 1
        op v{m}, v{m}, merge(v{m}[4:], 4) vl=64
    when s == 2
        op v{m}, v{m}, merge(v{m}[2:], 2) vl=32
    when s == 3
        op v{d}[dch:], v{m}, merge(v{m}[1:], 1) vl=16

fn softmax.l1(x: f16[1024, 128] @dram, y: f16[1024, 128] @dram)
    for c in 0..2
        send vc[c]
            run softmax_pipe(32, x + c*128K, y + c*128K)
    barrier
