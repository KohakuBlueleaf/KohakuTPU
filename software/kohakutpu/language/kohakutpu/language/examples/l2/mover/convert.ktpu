# x (row-major f16) converted by the mover's transforms: quantised into the
# clusters' A packing (a) and B packing (b), and into 4 x 4 sub-tiles (t).
target ktpu.v9

fn convert.l2(x: f16[64, 128] @dram, a: mx7a[64, 128] @dram(gm=8, nk=2), b: mx7b[64, 128] @dram(gn=16, nk=4), t: f16[64, 128] @dram(tile=8x8))
    quant a <- x
    quant b <- x
    gt4 t <- x
