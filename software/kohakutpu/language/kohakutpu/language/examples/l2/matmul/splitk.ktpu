# One 256 x 256 tile of x w^T with K = 1024 split over two clusters: each
# sums half of K; cluster 1 adds its accumulator into cluster 0's at full
# precision, and cluster 0 drains the sum.
target ktpu.v9

fn splitk.l2(x: mx7a[256, 1024] @dram(gm=64, nk=2), w: mx7b[256, 1024] @dram(gn=64, nk=2), y: f16[256, 256] @dram(tile=64x64))
    par u in 0..2 on mg[u]
        acc = zero                                          : f32[256, 256] @acc
        for k in 0..8
            a = fill x[0 : +256, (8*u + k)*64 : +64]        : mx7a[256, 64] @A
            b = fill w[0 : +256, (8*u + k)*64 : +64]        : mx7b[256, 64] @B
            acc = gemm a, b, acc                            : f32[256, 256] @acc
        when u == 1
            drain acc -> mg[0] add
        when u == 0
            drain acc -> y
