target ktpu.v9 vregs=128 vcopies=2

fn gelu.l2(h1: f16[24, 128] @dram, in1: f16[24, 128] @dram, out: f16[24, 128] @dram)
    par c1 in 0..1 on vc[c1]
        for t1 in 0..3
            xl1 = load h1[t1 * 8 : +8, 0 : +128]  : f16[8, 128] @l1(gt4)
            xl2 = load in1[t1 * 8 : +8, 0 : +128] : f16[8, 128] @l1(gt4)
            v1 = unpack xl2                                 : f32[8, 128] @reg(gt4)
            v2 = unpack xl1                                 : f32[8, 128] @reg(gt4)
            e1 = mul v1, v2                                 : f32[8, 128] @reg(gt4)
            e2 = mul v1, v1                                 : f32[8, 128] @reg(gt4)
            e3 = mul e2, v1                                 : f32[8, 128] @reg(gt4)
            e4 = mul 0.044715, e3                           : f32[8, 128] @reg(gt4)
            e5 = add v1, e4                                 : f32[8, 128] @reg(gt4)
            e6 = mul e5, -2.302208198144325                 : f32[8, 128] @reg(gt4)
            e7 = exp2 e6                                    : f32[8, 128] @reg(gt4)
            e8 = add 1.0, e7                                : f32[8, 128] @reg(gt4)
            e9 = inv e8                                     : f32[8, 128] @reg(gt4)
            e10 = mul e1, e9                                : f32[8, 128] @reg(gt4)
            e11 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e12 = mul e11, v1                               : f32[8, 128] @reg(gt4)
            e13 = mul 0.044715, e12                         : f32[8, 128] @reg(gt4)
            e14 = add v1, e13                               : f32[8, 128] @reg(gt4)
            e15 = mul e14, -2.302208198144325               : f32[8, 128] @reg(gt4)
            e16 = exp2 e15                                  : f32[8, 128] @reg(gt4)
            e17 = add 1.0, e16                              : f32[8, 128] @reg(gt4)
            e18 = inv e17                                   : f32[8, 128] @reg(gt4)
            e19 = mul e10, e18                              : f32[8, 128] @reg(gt4)
            e20 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e21 = mul e20, v1                               : f32[8, 128] @reg(gt4)
            e22 = mul 0.044715, e21                         : f32[8, 128] @reg(gt4)
            e23 = add v1, e22                               : f32[8, 128] @reg(gt4)
            e24 = mul e23, -2.302208198144325               : f32[8, 128] @reg(gt4)
            e25 = exp2 e24                                  : f32[8, 128] @reg(gt4)
            e26 = mul e19, e25                              : f32[8, 128] @reg(gt4)
            e27 = mul e26, 1.5957691216057308               : f32[8, 128] @reg(gt4)
            e28 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e29 = mul v1, v2                                : f32[8, 128] @reg(gt4)
            e30 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e31 = mul e30, v1                               : f32[8, 128] @reg(gt4)
            e32 = mul 0.044715, e31                         : f32[8, 128] @reg(gt4)
            e33 = add v1, e32                               : f32[8, 128] @reg(gt4)
            e34 = mul e33, -2.302208198144325               : f32[8, 128] @reg(gt4)
            e35 = exp2 e34                                  : f32[8, 128] @reg(gt4)
            e36 = add 1.0, e35                              : f32[8, 128] @reg(gt4)
            e37 = inv e36                                   : f32[8, 128] @reg(gt4)
            e38 = mul e29, e37                              : f32[8, 128] @reg(gt4)
            e39 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e40 = mul e39, v1                               : f32[8, 128] @reg(gt4)
            e41 = mul 0.044715, e40                         : f32[8, 128] @reg(gt4)
            e42 = add v1, e41                               : f32[8, 128] @reg(gt4)
            e43 = mul e42, -2.302208198144325               : f32[8, 128] @reg(gt4)
            e44 = exp2 e43                                  : f32[8, 128] @reg(gt4)
            e45 = add 1.0, e44                              : f32[8, 128] @reg(gt4)
            e46 = inv e45                                   : f32[8, 128] @reg(gt4)
            e47 = mul e38, e46                              : f32[8, 128] @reg(gt4)
            e48 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e49 = mul e48, v1                               : f32[8, 128] @reg(gt4)
            e50 = mul 0.044715, e49                         : f32[8, 128] @reg(gt4)
            e51 = add v1, e50                               : f32[8, 128] @reg(gt4)
            e52 = mul e51, -2.302208198144325               : f32[8, 128] @reg(gt4)
            e53 = exp2 e52                                  : f32[8, 128] @reg(gt4)
            e54 = mul e47, e53                              : f32[8, 128] @reg(gt4)
            e55 = mul e28, e54                              : f32[8, 128] @reg(gt4)
            e56 = mul e55, 0.21406444881780073              : f32[8, 128] @reg(gt4)
            e57 = add e27, e56                              : f32[8, 128] @reg(gt4)
            e58 = mul v1, v1                                : f32[8, 128] @reg(gt4)
            e59 = mul e58, v1                               : f32[8, 128] @reg(gt4)
            e60 = mul 0.044715, e59                         : f32[8, 128] @reg(gt4)
            e61 = add v1, e60                               : f32[8, 128] @reg(gt4)
            e62 = mul e61, -2.302208198144325               : f32[8, 128] @reg(gt4)
            e63 = exp2 e62                                  : f32[8, 128] @reg(gt4)
            e64 = add 1.0, e63                              : f32[8, 128] @reg(gt4)
            e65 = inv e64                                   : f32[8, 128] @reg(gt4)
            e66 = mul e65, v2                               : f32[8, 128] @reg(gt4)
            e67 = add e57, e66                              : f32[8, 128] @reg(gt4)
            p1 = pack e67                                   : f16[8, 128] @l1(gt4)
            store out[t1 * 8 : +8, 0 : +128] <- p1
