# silu over 131,072 values on two nodes, two cores each: every core runs the
# one-node kernel's share. The nodes share memory, so a node needs nothing
# from the other.
target ktpu.v9

image silu_stream(passes, x, y)
    desc a0 = x walk=(32, 128)
    desc a1 = y walk=(32, 128)
    ainc a0 += 4K
    ainc a1 += 4K
    seti s0 = -1.4426950408889634
    vfill a0 -> l1[0] rel
    seti s5 = passes
    loop s5
        expand unpk(0)
        for i in 0..8
            when i < 7
                expand unpk(i + 1)
            for j in 0..4
                vmul v{16 + (i%2)*4 + j}, v{(i%2)*4 + j}, s0
            for j in 0..4
                vexp2 v{16 + (i%2)*4 + j}, v{16 + (i%2)*4 + j}
            for j in 0..4
                vadd v{16 + (i%2)*4 + j}, v{16 + (i%2)*4 + j}, k1
            for j in 0..4
                vinv v{16 + (i%2)*4 + j}, v{16 + (i%2)*4 + j}
            for j in 0..4
                vmul v{16 + (i%2)*4 + j}, v{(i%2)*4 + j}, v{16 + (i%2)*4 + j}
            when i % 4 == 0
                vsync pack on=drain slack=1
            for j in 0..4
                vpack v{16 + (i%2)*4 + j} -> l1[256 + 128*(i/4) + ((i%4)*4 + j)*8] f16
            when i % 4 == 3
                vsync drain on=pack
                vdrain a1 <- l1[256 + 128*(i/4)] rel
    halt

macro unpk(i)
    when i % 4 == 0
        vbar
        vsync fill on=unpack
        vfill a0 -> l1[128 - 128*(i/4)] rel
    for j in 0..4
        vunpk v{(i%2)*4 + j} <- l1[128*(i/4) + ((i%4)*4 + j)*8] f16

fn silu2.l1(x: f16[131072] @dram, y: f16[131072] @dram)
    for n in 0..2
        node n
            for c in 0..2
                send vc[c]
                    run silu_stream(8, x + (2*n + c)*64K, y + (2*n + c)*64K)
            barrier
