# y = x w^T, 256 x 512 x 2048 on two nodes, tensor parallel by columns, the
# A chunk every cluster of a node reads shared a pair: a small witness that
# shared fills compute the same tile as private ones.
target ktpu.v9

fn share2.l2(x: mx7a[256, 512] @dram(gm=64, nk=4), w: mx7b[2048, 512] @dram(gn=64, nk=4), y: f16[256, 2048] @dram(tile=64x64))
    par n in 0..2 on node[n]
        par u in 0..4 on mg[u]
            acc = zero                                                  : f32[256, 256] @acc
            for k in 0..4
                a = fill x[0 : +256, k*128 : +128] share=cross          : mx7a[256, 128] @A
                b = fill w[(4*n + u)*256 : +256, k*128 : +128]          : mx7b[256, 128] @B
                acc = gemm a, b, acc                                    : f32[256, 256] @acc
            drain acc -> y[0 : +256, (4*n + u)*256 : +256]
