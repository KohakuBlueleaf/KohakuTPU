# y = x w^T, 1024 x 1024 x 1024 on four clusters: cluster u owns column tile
# u and sweeps the row tiles in turn, K in chunks of 64.
target ktpu.v9

fn matmul.l2(x: mx7a[1024, 1024] @dram(gm=64, nk=2), w: mx7b[1024, 1024] @dram(gn=64, nk=2), y: f16[1024, 1024] @dram(tile=64x64))
    par u in 0..4 on mg[u]
        for i in 0..4
            acc = zero                                      : f32[256, 256] @acc
            for k in 0..16
                a = fill x[i*256 : +256, k*64 : +64]        : mx7a[256, 64] @A
                b = fill w[u*256 : +256, k*64 : +64]        : mx7b[256, 64] @B
                acc = gemm a, b, acc                        : f32[256, 256] @acc
            drain acc -> y[i*256 : +256, u*256 : +256]
