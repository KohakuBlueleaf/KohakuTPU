target ktpu.v9

fn rows_98a2dd54e1.l2(in0: f16[16, 32] @dram, out: f16[16] @dram)
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load in0[t1*16 : +16, 0 : +32]  : f16[16, 32] @l1(gt4)
            v1 = unpack xl1                     : f32[16, 32] @reg(gt4)
            s1 = rmax v1                        : f32[16] @reg
            p1 = pack s1                        : f16[16] @l1
            store out[t1*16 : +16] <- p1
