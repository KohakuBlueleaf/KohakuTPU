target ktpu.v9

fn rows_57d625f117.l2(in0: f16[8, 128] @dram, in1: f16[16] @dram, in2: f16[16] @dram, x3: f16[8, 16] @dram, p3_index0: f32[16] @dram, p3_mask0: f16[1, 128] @dram, x4: f16[8, 16] @dram, p4_index0: f32[16] @dram, p4_mask0: f16[1, 128] @dram, out: f16[8, 128] @dram)
    h1 = buffer   : f16[128] @dram
    h2 = buffer   : f16[8, 128] @dram
    h3 = buffer   : f16[8, 128] @dram
    h4 = buffer   : f16[128] @dram
    h5 = buffer   : f16[8, 128] @dram
    h6 = buffer   : f16[8, 128] @dram
    h7 = buffer   : f16[16, 128] @dram
    h8 = buffer   : f16[16] @dram
    h9 = buffer   : f16[16] @dram
    h10 = buffer  : f16[16, 128] @dram
    fill h1 value=0 walk=((8, 32),) at=0
    gather h3[0 : +8, 0 : +128] <- x3 fp index=p3_index0[8 : +8]
    par c1 in 0..2 on vc[c1]
        xl1 = load p3_mask0[0 : +1]  : f16[1, 128] @l1
        v1 = unpack xl1              : f32[1, 128] @reg
        for t1 in 0..2
            xl2 = load h3[c1*4 + t1*2 : +2]  : f16[2, 128] @l1
            v2 = unpack xl2                  : f32[2, 128] @reg
            o1 = sel v1, v2, 0.0             : f32[2, 128] @reg
            p1 = pack o1                     : f16[2, 128] @l1
            store h2[c1*4 + t1*2 : +2] <- p1
    scatter h1 <- h2[0 : +8, 0 : +128] fp index=p3_index0[0 : +8] table_stride=64
    fill h4 value=0 walk=((8, 32),) at=0
    gather h6[0 : +8, 0 : +128] <- x4 fp index=p4_index0[8 : +8]
    par c2 in 0..2 on vc[c2]
        xl3 = load p4_mask0[0 : +1]  : f16[1, 128] @l1
        v3 = unpack xl3              : f32[1, 128] @reg
        for t2 in 0..2
            xl4 = load h6[c2*4 + t2*2 : +2]  : f16[2, 128] @l1
            v4 = unpack xl4                  : f32[2, 128] @reg
            o2 = sel v3, v4, 0.0             : f32[2, 128] @reg
            p2 = pack o2                     : f16[2, 128] @l1
            store h5[c2*4 + t2*2 : +2] <- p2
    scatter h4 <- h5[0 : +8, 0 : +128] fp index=p4_index0[0 : +8] table_stride=64
    fill h7 value=0
    copy h7[0 : +8] <- in0[0 : +8, 0 : +128]
    copy h8[0 : +16] <- in1[0 : +16]
    copy h9[0 : +16] <- in2[0 : +16]
    par c3 in 0..1 on vc[c3]
        xl5 = load h1[0 : +64]  : f16[4, 64] @l1(gt4)
        v5 = unpack xl5         : f32[4, 64] @reg(gt4)
        xl6 = load h4[0 : +64]  : f16[4, 64] @l1(gt4)
        v6 = unpack xl6         : f32[4, 64] @reg(gt4)
        for t3 in 0..1
            xl7 = load h7[t3*16 : +16, 0 : +64] : f16[16, 64] @l1(gt4)
            xl8 = load h8[t3*16 : +16]          : f16[16] @l1
            xl9 = load h9[t3*16 : +16]          : f16[16] @l1
            v7 = unpack xl8                     : f32[16] @reg
            e1 = mul v7, -1.0                   : f32[16] @reg
            v8 = unpack xl7                     : f32[16, 64] @reg(gt4)
            e2 = add v8, e1[:, *]               : f32[16, 64] @reg(gt4)
            v9 = unpack xl9                     : f32[16] @reg
            e3 = inv v9                         : f32[16] @reg
            e4 = mul e2, e3[:, *]               : f32[16, 64] @reg(gt4)
            e5 = mul e4, v5                     : f32[16, 64] @reg(gt4)
            e6 = add e5, v6                     : f32[16, 64] @reg(gt4)
            e7 = mul e6, -1.4426950408889634    : f32[16, 64] @reg(gt4)
            e8 = exp2 e7                        : f32[16, 64] @reg(gt4)
            e9 = add 1.0, e8                    : f32[16, 64] @reg(gt4)
            e10 = inv e9                        : f32[16, 64] @reg(gt4)
            e11 = mul e6, e10                   : f32[16, 64] @reg(gt4)
            p3 = pack e11                       : f16[16, 64] @l1(gt4)
            store h10[t3*16 : +16, 0 : +64] <- p3
    par c4 in 0..1 on vc[c4]
        xl10 = load h1[64 : +64]  : f16[4, 64] @l1(gt4)
        v10 = unpack xl10         : f32[4, 64] @reg(gt4)
        xl11 = load h4[64 : +64]  : f16[4, 64] @l1(gt4)
        v11 = unpack xl11         : f32[4, 64] @reg(gt4)
        for t4 in 0..1
            xl12 = load h7[t4*16 : +16, 64 : +64]  : f16[16, 64] @l1(gt4)
            xl13 = load h8[t4*16 : +16]         : f16[16] @l1
            xl14 = load h9[t4*16 : +16]         : f16[16] @l1
            v12 = unpack xl13                   : f32[16] @reg
            e12 = mul v12, -1.0                 : f32[16] @reg
            v13 = unpack xl12                   : f32[16, 64] @reg(gt4)
            e13 = add v13, e12[:, *]            : f32[16, 64] @reg(gt4)
            v14 = unpack xl14                   : f32[16] @reg
            e14 = inv v14                       : f32[16] @reg
            e15 = mul e13, e14[:, *]            : f32[16, 64] @reg(gt4)
            e16 = mul e15, v10                  : f32[16, 64] @reg(gt4)
            e17 = add e16, v11                  : f32[16, 64] @reg(gt4)
            e18 = mul e17, -1.4426950408889634  : f32[16, 64] @reg(gt4)
            e19 = exp2 e18                      : f32[16, 64] @reg(gt4)
            e20 = add 1.0, e19                  : f32[16, 64] @reg(gt4)
            e21 = inv e20                       : f32[16, 64] @reg(gt4)
            e22 = mul e17, e21                  : f32[16, 64] @reg(gt4)
            p4 = pack e22                       : f16[16, 64] @l1(gt4)
            store h10[t4*16 : +16, 64 : +64] <- p4
    copy out[0 : +8, 0 : +128] <- h10[0 : +8]
