target ktpu.v9

fn rows_58942454cb.l2(x0: f16[32, 16] @dram, out: f16[1, 512] @dram)
    h1 = buffer  : f16[4, 512] @dram
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load x0 read_map=((512, 0, 0, 512, ((32, 1), (16, 32)), ((32, 16), (16, 1))),) read_at=0 read_pitch=0 read_stride=1 read_rows=1  : f16[4, 256] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 256] @reg(gt4)
            e1 = add v1, 1.0                    : f32[4, 256] @reg(gt4)
            p1 = pack e1                        : f16[4, 256] @l1(gt4)
            store h1[t1*4 : +4, 0 : +256] <- p1
    par c2 in 0..1 on vc[c2]
        for t2 in 0..1
            xl2 = load x0 read_map=((512, 0, 0, 512, ((32, 1), (16, 32)), ((32, 16), (16, 1))),) read_at=256 read_pitch=0 read_stride=1 read_rows=1  : f16[4, 256] @l1(gt4)
            v2 = unpack xl2                     : f32[4, 256] @reg(gt4)
            e2 = add v2, 1.0                    : f32[4, 256] @reg(gt4)
            p2 = pack e2                        : f16[4, 256] @l1(gt4)
            store h1[t2*4 : +4, 256 : +256] <- p2
    copy out[0 : +1, 0 : +512] <- h1[0 : +1]
