target ktpu.v9

fn rows_8021be9bb8.l2(x0: f16[512, 16] @dram, in1: f16[64, 128] @dram, out: f16[64, 128] @dram)
    par c1 in 0..2 on vc[c1]
        for t1 in 0..2
            xl1 = load x0 read_map=((8192, 0, 0, 8192, ((64, 1), (128, 64)), ((64, 128), (128, 1))),) read_at=c1*4096 + t1*2048 read_pitch=128 read_stride=1  : f16[16, 32] @l1(gt4)
            xl2 = load in1[c1*32 + t1*16 : +16, 0 : +32]  : f16[16, 32] @l1(gt4)
            v1 = unpack xl1                     : f32[16, 32] @reg(gt4)
            e1 = mul v1, 0.9                    : f32[16, 32] @reg(gt4)
            v2 = unpack xl2                     : f32[16, 32] @reg(gt4)
            e2 = mul v2, 0.1                    : f32[16, 32] @reg(gt4)
            e3 = add e1, e2                     : f32[16, 32] @reg(gt4)
            p1 = pack e3                        : f16[16, 32] @l1(gt4)
            store out[c1*32 + t1*16 : +16, 0 : +32] <- p1
    par c2 in 0..2 on vc[c2]
        for t2 in 0..2
            xl3 = load x0 read_map=((8192, 0, 0, 8192, ((64, 1), (128, 64)), ((64, 128), (128, 1))),) read_at=c2*4096 + t2*2048 + 32 read_pitch=128 read_stride=1  : f16[16, 32] @l1(gt4)
            xl4 = load in1[c2*32 + t2*16 : +16, 32 : +32]  : f16[16, 32] @l1(gt4)
            v3 = unpack xl3                     : f32[16, 32] @reg(gt4)
            e4 = mul v3, 0.9                    : f32[16, 32] @reg(gt4)
            v4 = unpack xl4                     : f32[16, 32] @reg(gt4)
            e5 = mul v4, 0.1                    : f32[16, 32] @reg(gt4)
            e6 = add e4, e5                     : f32[16, 32] @reg(gt4)
            p2 = pack e6                        : f16[16, 32] @l1(gt4)
            store out[c2*32 + t2*16 : +16, 32 : +32] <- p2
    par c3 in 0..2 on vc[c3]
        for t3 in 0..2
            xl5 = load x0 read_map=((8192, 0, 0, 8192, ((64, 1), (128, 64)), ((64, 128), (128, 1))),) read_at=c3*4096 + t3*2048 + 64 read_pitch=128 read_stride=1  : f16[16, 32] @l1(gt4)
            xl6 = load in1[c3*32 + t3*16 : +16, 64 : +32]  : f16[16, 32] @l1(gt4)
            v5 = unpack xl5                     : f32[16, 32] @reg(gt4)
            e7 = mul v5, 0.9                    : f32[16, 32] @reg(gt4)
            v6 = unpack xl6                     : f32[16, 32] @reg(gt4)
            e8 = mul v6, 0.1                    : f32[16, 32] @reg(gt4)
            e9 = add e7, e8                     : f32[16, 32] @reg(gt4)
            p3 = pack e9                        : f16[16, 32] @l1(gt4)
            store out[c3*32 + t3*16 : +16, 64 : +32] <- p3
    par c4 in 0..2 on vc[c4]
        for t4 in 0..2
            xl7 = load x0 read_map=((8192, 0, 0, 8192, ((64, 1), (128, 64)), ((64, 128), (128, 1))),) read_at=c4*4096 + t4*2048 + 96 read_pitch=128 read_stride=1  : f16[16, 32] @l1(gt4)
            xl8 = load in1[c4*32 + t4*16 : +16, 96 : +32]  : f16[16, 32] @l1(gt4)
            v7 = unpack xl7                     : f32[16, 32] @reg(gt4)
            e10 = mul v7, 0.9                   : f32[16, 32] @reg(gt4)
            v8 = unpack xl8                     : f32[16, 32] @reg(gt4)
            e11 = mul v8, 0.1                   : f32[16, 32] @reg(gt4)
            e12 = add e10, e11                  : f32[16, 32] @reg(gt4)
            p4 = pack e12                       : f16[16, 32] @l1(gt4)
            store out[c4*32 + t4*16 : +16, 96 : +32] <- p4
