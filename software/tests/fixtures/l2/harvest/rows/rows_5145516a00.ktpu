target ktpu.v9

fn rows_5145516a00.l2(in0: f16[5, 64] @dram, in1: f16[16] @dram, in2: f16[16] @dram, in3: f16[64] @dram, in4: f16[64] @dram, out: f16[5, 64] @dram)
    h1 = buffer  : f16[16, 64] @dram
    h2 = buffer  : f16[16] @dram
    h3 = buffer  : f16[16] @dram
    h4 = buffer  : f16[16, 64] @dram
    fill h1 value=0
    copy h1[0 : +5] <- in0[0 : +5, 0 : +64]
    copy h2[0 : +16] <- in1[0 : +16]
    copy h3[0 : +16] <- in2[0 : +16]
    par c1 in 0..1 on vc[c1]
        xl1 = load in3[0 : +64]  : f16[4, 64] @l1(gt4)
        v1 = unpack xl1          : f32[4, 64] @reg(gt4)
        xl2 = load in4[0 : +64]  : f16[4, 64] @l1(gt4)
        v2 = unpack xl2          : f32[4, 64] @reg(gt4)
        for t1 in 0..1
            xl3 = load h1[t1*16 : +16, 0 : +64] : f16[16, 64] @l1(gt4)
            xl4 = load h2[t1*16 : +16]          : f16[16] @l1
            xl5 = load h3[t1*16 : +16]          : f16[16] @l1
            v3 = unpack xl4                     : f32[16] @reg
            e1 = mul v3, -1.0                   : f32[16] @reg
            v4 = unpack xl3                     : f32[16, 64] @reg(gt4)
            e2 = add v4, e1[:, *]               : f32[16, 64] @reg(gt4)
            v5 = unpack xl5                     : f32[16] @reg
            e3 = inv v5                         : f32[16] @reg
            e4 = mul e2, e3[:, *]               : f32[16, 64] @reg(gt4)
            e5 = mul e4, v1                     : f32[16, 64] @reg(gt4)
            e6 = add e5, v2                     : f32[16, 64] @reg(gt4)
            p1 = pack e6                        : f16[16, 64] @l1(gt4)
            store h4[t1*16 : +16, 0 : +64] <- p1
    copy out[0 : +5, 0 : +64] <- h4[0 : +5]
