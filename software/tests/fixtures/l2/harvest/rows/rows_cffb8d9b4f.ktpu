target ktpu.v9

fn rows_cffb8d9b4f.l2(in0: f16[5, 32] @dram, in1: f16[16] @dram, out: f16[5, 32] @dram)
    h1 = buffer  : f16[16, 32] @dram
    h2 = buffer  : f16[16] @dram
    h3 = buffer  : f16[16, 32] @dram
    fill h1 value=0
    copy h1[0 : +5] <- in0[0 : +5, 0 : +32]
    copy h2[0 : +16] <- in1[0 : +16]
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load h1[t1*16 : +16, 0 : +32] : f16[16, 32] @l1(gt4)
            xl2 = load h2[t1*16 : +16]          : f16[16] @l1
            v1 = unpack xl2                     : f32[16] @reg
            e1 = mul v1, -1.0                   : f32[16] @reg
            v2 = unpack xl1                     : f32[16, 32] @reg(gt4)
            e2 = add v2, e1[:, *]               : f32[16, 32] @reg(gt4)
            e3 = mul e2, 1.4426950408889634     : f32[16, 32] @reg(gt4)
            e4 = exp2 e3                        : f32[16, 32] @reg(gt4)
            p1 = pack e4                        : f16[16, 32] @l1(gt4)
            store h3[t1*16 : +16, 0 : +32] <- p1
    copy out[0 : +5, 0 : +32] <- h3[0 : +5]
