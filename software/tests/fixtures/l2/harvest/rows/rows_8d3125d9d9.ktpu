target ktpu.v9

fn rows_8d3125d9d9.l2(x0: f16[128, 16] @dram, in1: f16[32, 64] @dram, out: f16[32, 64] @dram)
    par c1 in 0..2 on vc[c1]
        for t1 in 0..1
            xl1 = load x0 read_map=((2048, 0, 0, 2048, ((32, 1), (64, 32)), ((32, 64), (64, 1))),) read_at=c1*1024 + t1*1024 read_pitch=64 read_stride=1  : f16[16, 32] @l1(gt4)
            xl2 = load in1[c1*16 + t1*16 : +16, 0 : +32]  : f16[16, 32] @l1(gt4)
            v1 = unpack xl1                     : f32[16, 32] @reg(gt4)
            e1 = mul v1, 0.9                    : f32[16, 32] @reg(gt4)
            v2 = unpack xl2                     : f32[16, 32] @reg(gt4)
            e2 = mul v2, 0.1                    : f32[16, 32] @reg(gt4)
            e3 = add e1, e2                     : f32[16, 32] @reg(gt4)
            p1 = pack e3                        : f16[16, 32] @l1(gt4)
            store out[c1*16 + t1*16 : +16, 0 : +32] <- p1
    par c2 in 0..2 on vc[c2]
        for t2 in 0..1
            xl3 = load x0 read_map=((2048, 0, 0, 2048, ((32, 1), (64, 32)), ((32, 64), (64, 1))),) read_at=c2*1024 + t2*1024 + 32 read_pitch=64 read_stride=1  : f16[16, 32] @l1(gt4)
            xl4 = load in1[c2*16 + t2*16 : +16, 32 : +32]  : f16[16, 32] @l1(gt4)
            v3 = unpack xl3                     : f32[16, 32] @reg(gt4)
            e4 = mul v3, 0.9                    : f32[16, 32] @reg(gt4)
            v4 = unpack xl4                     : f32[16, 32] @reg(gt4)
            e5 = mul v4, 0.1                    : f32[16, 32] @reg(gt4)
            e6 = add e4, e5                     : f32[16, 32] @reg(gt4)
            p2 = pack e6                        : f16[16, 32] @l1(gt4)
            store out[c2*16 + t2*16 : +16, 32 : +32] <- p2
