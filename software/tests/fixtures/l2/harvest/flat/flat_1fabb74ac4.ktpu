target ktpu.v9

fn flat_1fabb74ac4.l2(in0: f16[4, 128] @dram, out: f16[4, 128] @dram)
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load in0[0 : +4]  : f16[4, 128] @l1
            v1 = unpack xl1         : f32[4, 128] @reg
            e1 = mul v1, 2.0        : f32[4, 128] @reg
            e2 = max e1, 0.0        : f32[4, 128] @reg
            e3 = add e2, 1.0        : f32[4, 128] @reg
            p1 = pack e3            : f16[4, 128] @l1
            store out[0 : +4] <- p1
