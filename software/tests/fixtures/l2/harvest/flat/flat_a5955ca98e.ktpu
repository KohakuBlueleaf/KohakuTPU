target ktpu.v9

fn flat_a5955ca98e.l2(in0: f16[4, 128] @dram, in1: f16[4, 128] @dram, out: f16[4, 128] @dram)
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load in0[0 : +4]  : f16[4, 128] @l1
            xl2 = load in1[0 : +4]  : f16[4, 128] @l1
            v1 = unpack xl1         : f32[4, 128] @reg
            e1 = mul v1, 2.0        : f32[4, 128] @reg
            v2 = unpack xl2         : f32[4, 128] @reg
            e2 = add e1, v2         : f32[4, 128] @reg
            e3 = max e2, 0.0        : f32[4, 128] @reg
            e4 = mul e3, v1         : f32[4, 128] @reg
            e5 = mul v2, -1.0       : f32[4, 128] @reg
            e6 = add e4, e5         : f32[4, 128] @reg
            p1 = pack e6            : f16[4, 128] @l1
            store out[0 : +4] <- p1
