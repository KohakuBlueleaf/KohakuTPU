target ktpu.v9

fn flat_441f200caa.l2(in0: f16[4, 128] @dram, out: f16[4, 128] @dram)
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load in0[0 : +4]  : f16[4, 128] @l1
            v1 = unpack xl1         : f32[4, 128] @reg
            e1 = max v1, 1e-30      : f32[4, 128] @reg
            e2 = rsqrt e1           : f32[4, 128] @reg
            e3 = mul v1, e2         : f32[4, 128] @reg
            p1 = pack e3            : f16[4, 128] @l1
            store out[0 : +4] <- p1
