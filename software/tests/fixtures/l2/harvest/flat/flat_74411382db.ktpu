target ktpu.v9

fn flat_74411382db.l2(in0: f16[4, 128] @dram, out: f16[4, 128] @dram)
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load in0[0 : +4]            : f16[4, 128] @l1
            v1 = unpack xl1                   : f32[4, 128] @reg
            e1 = mul v1, -1.4426950408889634  : f32[4, 128] @reg
            e2 = exp2 e1                      : f32[4, 128] @reg
            e3 = add 1.0, e2                  : f32[4, 128] @reg
            e4 = inv e3                       : f32[4, 128] @reg
            e5 = mul v1, e4                   : f32[4, 128] @reg
            p1 = pack e5                      : f16[4, 128] @l1
            store out[0 : +4] <- p1
