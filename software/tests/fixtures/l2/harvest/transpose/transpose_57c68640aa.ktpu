target ktpu.v9

fn transpose_57c68640aa.l2(x: f16[64, 16] @dram, mask: f16[2, 128] @dram, y: f16[64, 16] @dram)
    h1 = buffer  : f16[8, 128] @dram
    h2 = buffer  : f16[8, 128] @dram
    h3 = buffer  : f16[64, 16] @dram
    gt4 h1 <- x walk=((1, 2048), (8, 256), (2, 32), (4, 64)) dwalk=((1, 2048), (8, 256), (2, 128))
    par c1 in 0..1 on vc[c1]
        xl1 = load mask[0 : +1]  : f16[1, 128] @l1
        v1 = unpack xl1          : f32[1, 128] @reg
        xl2 = load mask[1 : +1]  : f16[1, 128] @l1
        v2 = unpack xl2          : f32[1, 128] @reg
        for t1 in 0..1
            xl3 = load h1[t1*8 : +8]  : f16[8, 128] @l1
            v3 = unpack xl3           : f32[8, 128] @reg
            e1 = xlane v3, 5.0        : f32[8, 128] @reg
            o1 = sel v1, e1, v3       : f32[8, 128] @reg
            e2 = xlane o1, 10.0       : f32[8, 128] @reg
            o2 = sel v2, e2, o1       : f32[8, 128] @reg
            p1 = pack o2              : f16[8, 128] @l1
            store h2[t1*8 : +8] <- p1
    gt4 h3 <- h2 walk=((1, 2048), (8, 32), (2, 1024), (4, 256)) dwalk=((1, 2048), (8, 256), (2, 128))
    copy y <- h3 walk=((1, 2048), (8, 256), (4, 32), (2, 128)) dwalk=((64, 32),)
