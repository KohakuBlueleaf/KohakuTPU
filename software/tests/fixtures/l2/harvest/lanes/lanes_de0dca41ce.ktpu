target ktpu.v9

fn lanes_de0dca41ce.l2(src: f16[8, 16] @dram, dst: f16[8, 16] @dram, index: f32[16] @dram, mask: f16[1, 128] @dram)
    h1 = buffer  : f16[8, 128] @dram
    h2 = buffer  : f16[8, 128] @dram
    fill dst value=0 walk=((8, 32),) at=0
    gather h2[0 : +8, 0 : +128] <- src fp index=index[8 : +8]
    par c1 in 0..2 on vc[c1]
        xl1 = load mask[0 : +1]  : f16[1, 128] @l1
        v1 = unpack xl1          : f32[1, 128] @reg
        for t1 in 0..2
            xl2 = load h2[c1*4 + t1*2 : +2]  : f16[2, 128] @l1
            v2 = unpack xl2                  : f32[2, 128] @reg
            o1 = sel v1, v2, 0.0             : f32[2, 128] @reg
            p1 = pack o1                     : f16[2, 128] @l1
            store h1[c1*4 + t1*2 : +2] <- p1
    scatter dst <- h1[0 : +8, 0 : +128] fp index=index[0 : +8] table_stride=64
