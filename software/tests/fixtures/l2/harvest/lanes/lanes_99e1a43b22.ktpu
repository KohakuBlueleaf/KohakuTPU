target ktpu.v9

fn lanes_99e1a43b22.l2(src: f16[3072, 16] @dram, dst: f16[3072, 16] @dram, index: f32[8] @dram, mask: f16[2, 128] @dram)
    h1 = buffer  : f16[1536, 32] @dram
    h2 = buffer  : f16[3072, 16] @dram
    h3 = buffer  : f16[384, 128] @dram
    h4 = buffer  : f16[384, 128] @dram
    h5 = buffer  : f16[3072, 16] @dram
    copy h1 <- src walk=((3072, 32),) at=0 dwalk=((3072, 32),) dat=0
    gt4 h3 <- h1 walk=((1, 98304), (192, 512), (4, 32), (4, 128)) dwalk=((1, 98304), (192, 512), (4, 128))
    par c1 in 0..2 on vc[c1]
        xl1 = load mask[0 : +1]  : f16[1, 128] @l1
        v1 = unpack xl1          : f32[1, 128] @reg
        xl2 = load mask[1 : +1]  : f16[1, 128] @l1
        v2 = unpack xl2          : f32[1, 128] @reg
        for t1 in 0..24
            xl3 = load h3[c1*192 + t1*8 : +8]  : f16[8, 128] @l1
            v3 = unpack xl3                    : f32[8, 128] @reg
            e1 = xlane v3, 5.0                 : f32[8, 128] @reg
            o1 = sel v1, e1, v3                : f32[8, 128] @reg
            e2 = xlane o1, 10.0                : f32[8, 128] @reg
            o2 = sel v2, e2, o1                : f32[8, 128] @reg
            p1 = pack o2                       : f16[8, 128] @l1
            store h4[c1*192 + t1*8 : +8] <- p1
    gt4 h5 <- h4 walk=((1, 98304), (16, 32), (48, 2048), (4, 512)) dwalk=((1, 98304), (16, 6144), (48, 128))
    copy h2 <- h5 walk=((1, 98304), (16, 6144), (4, 32), (48, 128)) dwalk=((3072, 32),)
    copy dst <- h2 walk=((3072, 32),) at=0 dwalk=((3072, 32),) dat=0
