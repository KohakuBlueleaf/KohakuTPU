            e38 = xrot v94, 14.0                : f32[2, 128] @reg
            o37 = sel v91, e37, e38             : f32[2, 128] @reg
            xl95 = load h2[c19*4 + t19*2 + 144 : +2]  : f16[2, 128] @l1
            v95 = unpack xl95                   : f32[2, 128] @reg
            o38 = sel v92, o37, v95             : f32[2, 128] @reg
