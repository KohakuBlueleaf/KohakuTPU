            store h4[c19*4 + t19*2 + 144 : +2] <- p19
    scatter h1 <- h4[96 : +56, 0 : +64] fp index=index[224 : +56]
    copy dst <- h1 walk=((41, 32),) at=0 dwalk=((41, 32),) dat=0
