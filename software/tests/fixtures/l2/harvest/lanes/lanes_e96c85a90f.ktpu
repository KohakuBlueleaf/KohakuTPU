            e5 = xrot v10, 4.0                  : f32[2, 128] @reg
            e6 = xrot v11, 4.0                  : f32[2, 128] @reg
            o4 = sel v8, e5, e6                 : f32[2, 128] @reg
            o5 = sel v9, o4, 0.0                : f32[2, 128] @reg
            p3 = pack o5                        : f16[2, 128] @l1
            store h2[c3*4 + t3*2 + 16 : +2] <- p3
    par c4 in 0..2 on vc[c4]
        xl12 = load mask[1 : +1]  : f16[1, 128] @l1
        v12 = unpack xl12         : f32[1, 128] @reg
        for t4 in 0..2
            xl13 = load h3[c4*4 + t4*2 + 24 : +2]  : f16[2, 128] @l1
            v13 = unpack xl13                   : f32[2, 128] @reg
            xl14 = load h4[c4*4 + t4*2 + 24 : +2]  : f16[2, 128] @l1
