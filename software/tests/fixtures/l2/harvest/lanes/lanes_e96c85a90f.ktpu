target ktpu.v9

fn lanes_e96c85a90f.l2(src: f16[53, 16] @dram, dst: f16[60, 16] @dram, index: f32[144] @dram, mask: f16[6, 128] @dram)
    h1 = buffer  : f16[60, 16] @dram
    h2 = buffer  : f16[48, 128] @dram
    h3 = buffer  : f16[48, 128] @dram
    h4 = buffer  : f16[48, 128] @dram
    fill dst value=0 walk=((60, 32),) at=0
