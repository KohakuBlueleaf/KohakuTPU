            e7 = xrot v13, 8.0                  : f32[2, 128] @reg
            e8 = xrot v14, 8.0                  : f32[2, 128] @reg
            o6 = sel v12, e7, e8                : f32[2, 128] @reg
            p4 = pack o6                        : f16[2, 128] @l1
            store h2[c4*4 + t4*2 + 24 : +2] <- p4
    scatter dst <- h2[16 : +16, 0 : +64] fp index=index[48 : +16] table_stride=64
    par c5 in 0..2 on vc[c5]
        xl15 = load mask[4 : +1]  : f16[1, 128] @l1
        v15 = unpack xl15         : f32[1, 128] @reg
        for t5 in 0..2
            xl16 = load h3[c5*4 + t5*2 + 32 : +2]  : f16[2, 128] @l1
            v16 = unpack xl16                   : f32[2, 128] @reg
            o7 = sel v15, v16, 0.0              : f32[2, 128] @reg
            p5 = pack o7                        : f16[2, 128] @l1
            store h2[c5*4 + t5*2 + 32 : +2] <- p5
    par c6 in 0..2 on vc[c6]
        xl17 = load mask[5 : +1]  : f16[1, 128] @l1
        v17 = unpack xl17         : f32[1, 128] @reg
        xl18 = load mask[4 : +1]  : f16[1, 128] @l1
