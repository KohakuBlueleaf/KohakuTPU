            e2 = xrot v3, 4.0                : f32[2, 128] @reg
            o1 = sel v1, e1, e2              : f32[2, 128] @reg
            p1 = pack o1                     : f16[2, 128] @l1
            store h2[c1*4 + t1*2 : +2] <- p1
    par c2 in 0..2 on vc[c2]
        xl4 = load mask[1 : +1]  : f16[1, 128] @l1
