            store h2[c2*4 + t2*2 + 8 : +2] <- p2
    scatter dst <- h2[0 : +16, 0 : +32] fp index=index[0 : +16] table_stride=64
    par c3 in 0..2 on vc[c3]
        xl8 = load mask[0 : +1]  : f16[1, 128] @l1
