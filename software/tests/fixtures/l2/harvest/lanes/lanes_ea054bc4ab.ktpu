    par c3 in 0..2 on vc[c3]
        xl9 = load mask[2 : +1]   : f16[1, 128] @l1
        v9 = unpack xl9           : f32[1, 128] @reg
        xl10 = load mask[1 : +1]  : f16[1, 128] @l1
