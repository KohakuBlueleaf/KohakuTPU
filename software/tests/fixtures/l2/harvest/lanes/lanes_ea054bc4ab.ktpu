target ktpu.v9

fn lanes_ea054bc4ab.l2(src: f16[392, 16] @dram, dst: f16[512, 16] @dram, index: f32[672] @dram, mask: f16[5, 128] @dram)
    h1 = buffer  : f16[396, 16] @dram
    h2 = buffer  : f16[224, 128] @dram
    h3 = buffer  : f16[224, 128] @dram
    h4 = buffer  : f16[224, 128] @dram
    fill dst value=0 walk=((512, 32),) at=0
    copy h1 <- src walk=((392, 32),) dwalk=((392, 32),) dat=64
    gather h3[0 : +224, 0 : +32] <- h1 fp index=index[224 : +224]
    gather h4[0 : +224, 0 : +32] <- h1 fp index=index[448 : +224]
    par c1 in 0..2 on vc[c1]
