            e1 = xrot v3, 2.0                 : f32[2, 128] @reg
            e2 = xrot v4, 2.0                 : f32[2, 128] @reg
            o1 = sel v1, e1, e2               : f32[2, 128] @reg
            o2 = sel v2, o1, 0.0              : f32[2, 128] @reg
