            v11 = unpack xl11                   : f32[2, 128] @reg
            xl12 = load h4[c3*28 + t3*2 + 112 : +2]  : f16[2, 128] @l1
            v12 = unpack xl12                   : f32[2, 128] @reg
            e5 = xrot v11, 10.0                 : f32[2, 128] @reg
            e6 = xrot v12, 10.0                 : f32[2, 128] @reg
            o5 = sel v9, e5, e6                 : f32[2, 128] @reg
            o6 = sel v10, o5, 0.0               : f32[2, 128] @reg
            p3 = pack o6                        : f16[2, 128] @l1
            store h2[c3*28 + t3*2 + 112 : +2] <- p3
    par c4 in 0..2 on vc[c4]
        xl13 = load mask[0 : +1]  : f16[1, 128] @l1
        v13 = unpack xl13         : f32[1, 128] @reg
        xl14 = load mask[1 : +1]  : f16[1, 128] @l1
        v14 = unpack xl14         : f32[1, 128] @reg
        for t4 in 0..14
            xl15 = load h3[c4*28 + t4*2 + 168 : +2]  : f16[2, 128] @l1
            v15 = unpack xl15                   : f32[2, 128] @reg
            xl16 = load h4[c4*28 + t4*2 + 168 : +2]  : f16[2, 128] @l1
