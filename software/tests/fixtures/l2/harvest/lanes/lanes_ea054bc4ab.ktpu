            xl8 = load h4[c2*28 + t2*2 + 56 : +2]  : f16[2, 128] @l1
            v8 = unpack xl8                     : f32[2, 128] @reg
            e3 = xrot v7, 6.0                   : f32[2, 128] @reg
            e4 = xrot v8, 6.0                   : f32[2, 128] @reg
            o3 = sel v5, e3, e4                 : f32[2, 128] @reg
            o4 = sel v6, o3, 0.0                : f32[2, 128] @reg
