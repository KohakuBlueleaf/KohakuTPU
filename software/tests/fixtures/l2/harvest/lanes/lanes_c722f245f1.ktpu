target ktpu.v9

fn lanes_c722f245f1.l2(src: f16[64, 16] @dram, dst: f16[64, 16] @dram, index: f32[8] @dram, mask: f16[2, 128] @dram)
    h1 = buffer  : f16[32, 32] @dram
    h2 = buffer  : f16[64, 16] @dram
    h3 = buffer  : f16[8, 128] @dram
    h4 = buffer  : f16[8, 128] @dram
    h5 = buffer  : f16[64, 16] @dram
    copy h1 <- src walk=((64, 32),) at=0 dwalk=((64, 32),) dat=0
    gt4 h3 <- h1 walk=((1, 2048), (8, 256), (2, 32), (4, 64)) dwalk=((1, 2048), (8, 256), (2, 128))
    par c1 in 0..1 on vc[c1]
        xl1 = load mask[0 : +1]  : f16[1, 128] @l1
        v1 = unpack xl1          : f32[1, 128] @reg
        xl2 = load mask[1 : +1]  : f16[1, 128] @l1
        v2 = unpack xl2          : f32[1, 128] @reg
        for t1 in 0..1
            xl3 = load h3[t1*8 : +8]  : f16[8, 128] @l1
            v3 = unpack xl3           : f32[8, 128] @reg
            e1 = xlane v3, 5.0        : f32[8, 128] @reg
            o1 = sel v1, e1, v3       : f32[8, 128] @reg
            e2 = xlane o1, 10.0       : f32[8, 128] @reg
            o2 = sel v2, e2, o1       : f32[8, 128] @reg
            p1 = pack o2              : f16[8, 128] @l1
            store h4[t1*8 : +8] <- p1
    gt4 h5 <- h4 walk=((1, 2048), (8, 32), (2, 1024), (4, 256)) dwalk=((1, 2048), (8, 256), (2, 128))
    copy h2 <- h5 walk=((1, 2048), (8, 256), (4, 32), (2, 128)) dwalk=((64, 32),)
    copy dst <- h2 walk=((64, 32),) at=0 dwalk=((64, 32),) dat=0
