target ktpu.v9

fn lanes_b090742426.l2(src: f16[48, 16] @dram, dst: f16[48, 16] @dram, index: f32[80] @dram, mask: f16[3, 128] @dram)
    h1 = buffer  : f16[40, 128] @dram
    h2 = buffer  : f16[40, 128] @dram
    fill dst value=0 walk=((48, 32),) at=0
    gather h2[0 : +16, 0 : +32] <- src fp index=index[16 : +16]
    gather h2[16 : +16, 0 : +64] <- src fp index=index[48 : +16]
    gather h2[32 : +8, 0 : +96] <- src fp index=index[72 : +8]
    scatter dst <- h2[0 : +8, 0 : +32] fp index=index[0 : +8] table_stride=64
    par c1 in 0..2 on vc[c1]
        xl1 = load mask[0 : +1]  : f16[1, 128] @l1
        v1 = unpack xl1          : f32[1, 128] @reg
        for t1 in 0..2
            xl2 = load h2[c1*4 + t1*2 + 8 : +2] : f16[2, 128] @l1
            v2 = unpack xl2                     : f32[2, 128] @reg
            o1 = sel v1, v2, 0.0                : f32[2, 128] @reg
            p1 = pack o1                        : f16[2, 128] @l1
            store h1[c1*4 + t1*2 + 8 : +2] <- p1
    scatter dst <- h1[8 : +8, 0 : +32] fp index=index[8 : +8] table_stride=64
    scatter dst <- h2[16 : +8, 0 : +64] fp index=index[32 : +8] table_stride=64
    par c2 in 0..2 on vc[c2]
        xl3 = load mask[1 : +1]  : f16[1, 128] @l1
        v3 = unpack xl3          : f32[1, 128] @reg
        for t2 in 0..2
            xl4 = load h2[c2*4 + t2*2 + 24 : +2]  : f16[2, 128] @l1
            v4 = unpack xl4                     : f32[2, 128] @reg
            o2 = sel v3, v4, 0.0                : f32[2, 128] @reg
            p2 = pack o2                        : f16[2, 128] @l1
            store h1[c2*4 + t2*2 + 24 : +2] <- p2
    scatter dst <- h1[24 : +8, 0 : +64] fp index=index[40 : +8] table_stride=64
    par c3 in 0..2 on vc[c3]
        xl5 = load mask[2 : +1]  : f16[1, 128] @l1
        v5 = unpack xl5          : f32[1, 128] @reg
        for t3 in 0..2
            xl6 = load h2[c3*4 + t3*2 + 32 : +2]  : f16[2, 128] @l1
            v6 = unpack xl6                     : f32[2, 128] @reg
            o3 = sel v5, v6, 0.0                : f32[2, 128] @reg
            p3 = pack o3                        : f16[2, 128] @l1
            store h1[c3*4 + t3*2 + 32 : +2] <- p3
    scatter dst <- h1[32 : +8, 0 : +96] fp index=index[64 : +8] table_stride=64
