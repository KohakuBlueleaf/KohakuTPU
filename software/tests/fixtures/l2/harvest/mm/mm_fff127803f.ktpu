target ktpu.v9

fn mm_fff127803f.l2(a: mx7a[8, 64] @dram(gm=2, nk=1), b: mx7b[32, 64] @dram(gn=8, nk=1), out: f16[8, 32] @dram)
    h1 = buffer  : f16[8, 32] @dram(tile=2x8)
    par u1 in 0..1 on mg[u1]
        for k1 in 0..1
            acc1 = zero  : f32[8, 32] @acc
            for k2 in 0..2
                a1 = fill a[u1*8 + k1*8 : +8, k2*32 : +32]  : mx7a[8, 32] @A
                b1 = fill b[0 : +32, k2*32 : +32]  : mx7b[32, 32] @B
                acc1 = gemm a1, b1, acc1        : f32[8, 32] @acc
            drain acc1 -> h1[u1*8 + k1*8 : +8, 0 : +32]
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load h1[t1*8 : +8, 0 : +32]  : f16[8, 32] @l1(gt4)
            v1 = unpack xl1                    : f32[8, 32] @reg(gt4)
            e1 = mul v1, 0.125                 : f32[8, 32] @reg(gt4)
            p1 = pack e1                       : f16[8, 32] @l1(gt4)
            store out[t1*8 : +8, 0 : +32] <- p1
