target ktpu.v9

fn mm_7df999fe1e.l2(a: mx7a[16, 32] @dram(gm=4, nk=1), b: mx7b[32, 32] @dram(gn=8, nk=1), out: f16[16, 32] @dram)
    h1 = buffer  : f16[16, 32] @dram(tile=4x8)
    par u1 in 0..1 on mg[u1]
        for k1 in 0..1
            acc1 = zero  : f32[16, 32] @acc
            for k2 in 0..1
                a1 = fill a[u1*16 + k1*16 : +16, k2*32 : +32]  : mx7a[16, 32] @A
                b1 = fill b[0 : +32, k2*32 : +32]  : mx7b[32, 32] @B
                acc1 = gemm a1, b1, acc1        : f32[16, 32] @acc
            drain acc1 -> h1[u1*16 + k1*16 : +16, 0 : +32]
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load h1[t1*16 : +16, 0 : +32] : f16[16, 32] @l1(gt4)
            v1 = unpack xl1                     : f32[16, 32] @reg(gt4)
            p1 = pack v1                        : f16[16, 32] @l1(gt4)
            store out[t1*16 : +16, 0 : +32] <- p1
