target ktpu.v9

fn mm_a4eac8203f.l2(a: mx7a[8, 64] @dram(gm=2, nk=1), b: mx7b[192, 64] @dram(gn=16, nk=1), out: f16[8, 192] @dram)
    h1 = buffer  : f16[8, 192] @dram(tile=2x16)
    par u1 in 0..3 on mg[u1]
        for k1 in 0..1
            acc1 = zero  : f32[8, 64] @acc
            for k2 in 0..2
                a1 = fill a[((u1 + k1*3) / 3)*8 : +8, k2*32 : +32]  : mx7a[8, 32] @A
                b1 = fill b[((u1 + k1*3) % 3)*64 : +64, k2*32 : +32]  : mx7b[64, 32] @B
                acc1 = gemm a1, b1, acc1        : f32[8, 64] @acc
            drain acc1 -> h1[((u1 + k1*3) / 3)*8 : +8, ((u1 + k1*3) % 3)*64 : +64]
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load h1[c1*8 + t1*8 : +8, 0 : +64]  : f16[8, 64] @l1(gt4)
            v1 = unpack xl1                     : f32[8, 64] @reg(gt4)
            p1 = pack v1                        : f16[8, 64] @l1(gt4)
            store out[c1*8 + t1*8 : +8, 0 : +64] <- p1
    par c2 in 0..1 on vc[c2]
        for t2 in 0..1
            xl2 = load h1[c2*8 + t2*8 : +8, 64 : +64]  : f16[8, 64] @l1(gt4)
            v2 = unpack xl2                     : f32[8, 64] @reg(gt4)
            p2 = pack v2                        : f16[8, 64] @l1(gt4)
            store out[c2*8 + t2*8 : +8, 64 : +64] <- p2
    par c3 in 0..1 on vc[c3]
        for t3 in 0..1
            xl3 = load h1[c3*8 + t3*8 : +8, 128 : +64]  : f16[8, 64] @l1(gt4)
            v3 = unpack xl3                     : f32[8, 64] @reg(gt4)
            p3 = pack v3                        : f16[8, 64] @l1(gt4)
            store out[c3*8 + t3*8 : +8, 128 : +64] <- p3
