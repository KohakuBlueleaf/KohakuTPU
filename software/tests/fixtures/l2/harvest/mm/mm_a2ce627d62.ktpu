target ktpu.v9

fn mm_a2ce627d62.l2(a: mx7a[8, 128] @dram(gm=2, nk=1), b: mx7b[96, 128] @dram(gn=8, nk=1), in1: f16[96] @dram, out: f16[8, 96] @dram)
    h1 = buffer  : f16[8, 96] @dram(tile=2x8)
    par u1 in 0..3 on mg[u1]
        for k1 in 0..1
            acc1 = zero  : f32[8, 32] @acc
            for k2 in 0..4
                a1 = fill a[((u1 + k1*3) / 3)*8 : +8, k2*32 : +32]  : mx7a[8, 32] @A
                b1 = fill b[((u1 + k1*3) % 3)*32 : +32, k2*32 : +32]  : mx7b[32, 32] @B
                acc1 = gemm a1, b1, acc1        : f32[8, 32] @acc
            drain acc1 -> h1[((u1 + k1*3) / 3)*8 : +8, ((u1 + k1*3) % 3)*32 : +32]
    par c1 in 0..1 on vc[c1]
        xl1 = load in1[0 : +32]  : f16[4, 32] @l1(gt4)
        v1 = unpack xl1          : f32[4, 32] @reg(gt4)
        for t1 in 0..1
            xl2 = load h1[c1*8 + t1*8 : +8, 0 : +32]  : f16[8, 32] @l1(gt4)
            v2 = unpack xl2                     : f32[8, 32] @reg(gt4)
            e1 = add v2, v1                     : f32[8, 32] @reg(gt4)
            e2 = add v2, v1                     : f32[8, 32] @reg(gt4)
            e3 = mul e2, -1.4426950408889634    : f32[8, 32] @reg(gt4)
            e4 = exp2 e3                        : f32[8, 32] @reg(gt4)
            e5 = add 1.0, e4                    : f32[8, 32] @reg(gt4)
            e6 = inv e5                         : f32[8, 32] @reg(gt4)
            e7 = mul e1, e6                     : f32[8, 32] @reg(gt4)
            p1 = pack e7                        : f16[8, 32] @l1(gt4)
            store out[c1*8 + t1*8 : +8, 0 : +32] <- p1
    par c2 in 0..1 on vc[c2]
        xl3 = load in1[32 : +32]  : f16[4, 32] @l1(gt4)
        v3 = unpack xl3           : f32[4, 32] @reg(gt4)
        for t2 in 0..1
            xl4 = load h1[c2*8 + t2*8 : +8, 32 : +32]  : f16[8, 32] @l1(gt4)
            v4 = unpack xl4                     : f32[8, 32] @reg(gt4)
            e8 = add v4, v3                     : f32[8, 32] @reg(gt4)
            e9 = add v4, v3                     : f32[8, 32] @reg(gt4)
            e10 = mul e9, -1.4426950408889634   : f32[8, 32] @reg(gt4)
            e11 = exp2 e10                      : f32[8, 32] @reg(gt4)
            e12 = add 1.0, e11                  : f32[8, 32] @reg(gt4)
            e13 = inv e12                       : f32[8, 32] @reg(gt4)
            e14 = mul e8, e13                   : f32[8, 32] @reg(gt4)
            p2 = pack e14                       : f16[8, 32] @l1(gt4)
            store out[c2*8 + t2*8 : +8, 32 : +32] <- p2
    par c3 in 0..1 on vc[c3]
        xl5 = load in1[64 : +32]  : f16[4, 32] @l1(gt4)
        v5 = unpack xl5           : f32[4, 32] @reg(gt4)
        for t3 in 0..1
            xl6 = load h1[c3*8 + t3*8 : +8, 64 : +32]  : f16[8, 32] @l1(gt4)
            v6 = unpack xl6                     : f32[8, 32] @reg(gt4)
            e15 = add v6, v5                    : f32[8, 32] @reg(gt4)
            e16 = add v6, v5                    : f32[8, 32] @reg(gt4)
            e17 = mul e16, -1.4426950408889634  : f32[8, 32] @reg(gt4)
            e18 = exp2 e17                      : f32[8, 32] @reg(gt4)
            e19 = add 1.0, e18                  : f32[8, 32] @reg(gt4)
            e20 = inv e19                       : f32[8, 32] @reg(gt4)
            e21 = mul e15, e20                  : f32[8, 32] @reg(gt4)
            p3 = pack e21                       : f16[8, 32] @l1(gt4)
            store out[c3*8 + t3*8 : +8, 64 : +32] <- p3
