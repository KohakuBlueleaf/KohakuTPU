target ktpu.v9

fn mm_9729ff957c.l2(a: mx7a[8, 32] @dram(gm=2, nk=1), b: mx7b[64, 32] @dram(gn=16, nk=1), out: f16[8, 64] @dram)
    h1 = buffer  : f16[8, 64] @dram(tile=2x16)
    par u1 in 0..1 on mg[u1]
        for k1 in 0..1
            acc1 = zero  : f32[8, 64] @acc
            for k2 in 0..1
                a1 = fill a[u1*8 + k1*8 : +8, k2*32 : +32]  : mx7a[8, 32] @A
                b1 = fill b[0 : +64, k2*32 : +32]  : mx7b[64, 32] @B
                acc1 = gemm a1, b1, acc1        : f32[8, 64] @acc
            drain acc1 -> h1[u1*8 + k1*8 : +8, 0 : +64]
    par c1 in 0..1 on vc[c1]
        for t1 in 0..1
            xl1 = load h1[t1*8 : +8, 0 : +64]  : f16[8, 64] @l1(gt4)
            v1 = unpack xl1                    : f32[8, 64] @reg(gt4)
            p1 = pack v1                       : f16[8, 64] @l1(gt4)
            store out[t1*8 : +8, 0 : +64] <- p1
