target ktpu.v9

fn mm_cead3093d8.l2(a: mx7a[864, 32] @dram(gm=36, nk=1), b: mx7b[96, 32] @dram(gn=8, nk=1), out: f16[864, 32] @dram)
    h1 = buffer  : f16[864, 32] @dram(tile=36x8)
    for k1 in 0..3
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[144, 32] @acc
                for k3 in 0..1
                    a1 = fill a[k1*288 + u1*144 + k2*288 : +144, k3*32 : +32]  : mx7a[144, 32] @A
                    b1 = fill b[k1*32 : +32, k3*32 : +32]  : mx7b[32, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[144, 32] @acc
                drain acc1 -> h1[k1*288 + u1*144 + k2*288 : +144, 0 : +32]
        par c1 in 0..2 on vc[c1]
            for t1 in 0..9
                xl1 = load h1[c1*144 + t1*16 + k1*288 : +16, 0 : +32]  : f16[16, 32] @l1(gt4)
                v1 = unpack xl1                 : f32[16, 32] @reg(gt4)
                p1 = pack v1                    : f16[16, 32] @l1(gt4)
                store out[c1*144 + t1*16 + k1*288 : +16, 0 : +32] <- p1
