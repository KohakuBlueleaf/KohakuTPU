target ktpu.v9

fn mm_quant_ring_relu.l2(a: f16[8, 784] @dram, b: mx7b[128, 800] @dram(gn=16, nk=1), out: f16[8, 128] @dram)
    h1 = buffer  : f16[32, 64] @stage(tile=2x16)
    h2 = buffer  : mx7a[8, 800] @stage(gm=2, nk=1)
    for k1 in 0..1 pipe=2
        when k1*2 < 2
            when (k1*2 % 2) == 0
                quant h2[0 : +8] <- a[k1*8 : +8] finite_batch=4 pipeline=1 zero_classifier=1 stream_axes=1 fill_overlap=1 zero_reuse=1 pad=1 overlap=1
        when (k1*2 + 1) < 2
            when ((k1*2 + 1) % 2) == 0
                quant h2[0 : +8] <- a[((k1*2 + 1) / 2)*8 : +8] finite_batch=4 pipeline=1 zero_classifier=1 stream_axes=1 fill_overlap=1 zero_reuse=1 pad=1 overlap=1
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[8, 64] @acc
                for k3 in 0..25
                    a1 = fill h2[0 : +8, k3*32 : +32]  : mx7a[8, 32] @A
                    b1 = fill b[(((k1*2 + u1 + k2*2) % 2) % 2)*64 : +64, k3*32 : +32]  : mx7b[64, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[8, 64] @acc
                drain acc1 -> h1[(k1 % 2)*16 + u1*8 + k2*16 : +8, 0 : +64]
        par c1 in 0..2 on vc[c1]
            for t1 in 0..1
                xl1 = load h1[(k1 % 2)*16 + c1*8 + t1*8 : +8, 0 : +64]  : f16[8, 64] @l1(gt4)
                v1 = unpack xl1                 : f32[8, 64] @reg(gt4)
                e1 = max v1, 0.0                : f32[8, 64] @reg(gt4)
                p1 = pack e1                    : f16[8, 64] @l1(gt4)
                store out[((k1*2 + c1) / 2)*8 + (((k1*2 + c1) % 2) / 2)*8 + t1*8 : +8, (((k1*2 + c1) % 2) % 2)*64 : +64] <- p1
