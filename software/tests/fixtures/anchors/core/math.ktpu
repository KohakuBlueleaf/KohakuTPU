    vfill a0 -> l1[0] rel
    vbar
    vunpk v0 <- l1[0] f16
    vmov v1, v0
    vcmpeq p3, v0[1 :], v0[2 :]
    vmov v1, k0 if=p3
    vsync pack on=drain slack=1
    vpack v1 -> l1[16] f16
    vsync drain on=pack
    vdrain a1 <- l1[16] rel
    halt

