image a_vcmplt(in, out)
    desc a0=in walk=(32, 8)
    desc a1=out walk=(32, 8)
    vfill a0 -> l1[0] rel
    vbar
    vunpk v0 <- l1[0] f16
    vmov v1, v0
    vcmplt p1, v0, v0[1 :]
    vmov v1, k0 if=p1
    vsync pack on=drain slack=1
    vpack v1 -> l1[16] f16
    vsync drain on=pack
    vdrain a1 <- l1[16] rel
    halt

image a_vcmpgt(in, out)
    desc a0=in walk=(32, 8)
    desc a1=out walk=(32, 8)
    vfill a0 -> l1[0] rel
    vbar
    vunpk v0 <- l1[0] f16
    vmov v1, v0
    vcmpgt p2, v0, v0[1 :]
    vmov v1, k0 unless=p2
    vsync pack on=drain slack=1
    vpack v1 -> l1[16] f16
    vsync drain on=pack
    vdrain a1 <- l1[16] rel
