  "source": "@kt.kernel\ndef k(x=kt.In(8, 32), y=kt.Out(8, 32)):\n    for c in kt.par(2, on=kt.vc):\n        for t in kt.range(1):\n            r = c * 4 + t * 4\n            v = kt.unpack(kt.load(x[r : r + 4, :], gt4=True))\n            a = v * v + v\n            b = kt.maximum(a, 0.5)\n            e = kt.exp2(kt.log2(kt.recip(kt.rsqrt(b))))\n            w = kt.where(v, e, v)\n            z = kt.xlane(w, 1)\n            s = kt.rmax(z)\n            u = kt.rsum(z)\n            kt.store(y[r : r + 4, :], z * s * u)\n",
