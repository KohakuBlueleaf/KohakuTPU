target ktpu.v9

fn product.l2(a: mx7a[200, 768] @dram(gm=50, nk=2), b: mx7b[192, 768] @dram(gn=8, nk=2), in1: f16[200, 192] @dram, in2: f16[192] @dram, out: f16[200, 192] @dram)
    h1 = buffer  : f16[800, 32] @stage(tile=50x8)
    for k1 in 0..3 pipe=2
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 32] @acc
                for k3 in 0..12
                    a1 = fill a[((k1*2 + u1 + k2*2) / 6)*200 + (((k1*2 + u1 + k2*2) % 6) / 6)*200 : +200, k3*64 : +64]  : mx7a[200, 64] @A
                    b1 = fill b[(((k1*2 + u1 + k2*2) % 6) % 6)*32 : +32, k3*64 : +64]  : mx7b[32, 64] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 32] @acc
                drain acc1 -> h1[(k1 % 2)*400 + u1*200 + k2*400 : +200, 0 : +32]
        par c1 in 0..2 on vc[c1]
            xl1 = load in2[(((k1*2 + c1) % 6) % 6)*32 : +32]  : f16[4, 32] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 32] @reg(gt4)
            for t1 in 0..12
                xl2 = load h1[(k1 % 2)*400 + c1*200 + t1*16 : +16, 0 : +32]  : f16[16, 32] @l1(gt4)
                xl3 = load in1[((k1*2 + c1) / 6)*200 + (((k1*2 + c1) % 6) / 6)*200 + t1*16 : +16, (((k1*2 + c1) % 6) % 6)*32 : +32]  : f16[16, 32] @l1(gt4)
                v2 = unpack xl2                 : f32[16, 32] @reg(gt4)
                e1 = add v2, v1                 : f32[16, 32] @reg(gt4)
                v3 = unpack xl3                 : f32[16, 32] @reg(gt4)
                e2 = add v3, e1                 : f32[16, 32] @reg(gt4)
                p1 = pack e2                    : f16[16, 32] @l1(gt4)
                store out[((k1*2 + c1) / 6)*200 + (((k1*2 + c1) % 6) / 6)*200 + t1*16 : +16, (((k1*2 + c1) % 6) % 6)*32 : +32] <- p1
        par c2 in 0..2 on vc[c2]
            xl4 = load in2[(((k1*2 + c2) % 6) % 6)*32 : +32]  : f16[4, 32] @l1(gt4)
            v4 = unpack xl4                     : f32[4, 32] @reg(gt4)
            for t2 in 0..1
                xl5 = load h1[(k1 % 2)*400 + c2*200 + t2*8 + 192 : +8, 0 : +32]  : f16[8, 32] @l1(gt4)
                xl6 = load in1[((k1*2 + c2) / 6)*200 + (((k1*2 + c2) % 6) / 6)*200 + t2*8 + 192 : +8, (((k1*2 + c2) % 6) % 6)*32 : +32]  : f16[8, 32] @l1(gt4)
                v5 = unpack xl5                 : f32[8, 32] @reg(gt4)
                e3 = add v5, v4                 : f32[8, 32] @reg(gt4)
                v6 = unpack xl6                 : f32[8, 32] @reg(gt4)
                e4 = add v6, e3                 : f32[8, 32] @reg(gt4)
                p2 = pack e4                    : f16[8, 32] @l1(gt4)
                store out[((k1*2 + c2) / 6)*200 + (((k1*2 + c2) % 6) / 6)*200 + t2*8 + 192 : +8, (((k1*2 + c2) % 6) % 6)*32 : +32] <- p2
