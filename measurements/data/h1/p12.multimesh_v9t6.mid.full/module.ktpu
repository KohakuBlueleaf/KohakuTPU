target ktpu.v9

image put_512_8_2048(n, src, dst)
    desc a0 = src walk=(32, 128)
    desc a1 = dst walk=((32, 16), (2048, 8))
    ainc a0 += 4096
    ainc a1 += 16384
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync drain on=fill
        vdrain a1 <- l1[0] rel
        vsync fill on=drain
    halt

image get_256(n, src, v)
    desc a0 = src walk=(32, 256)
    desc a1 = v walk=(32, 256)
    ainc a0 += 8192
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync fe on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

image get_128(n, src, v)
    desc a0 = src walk=(32, 128)
    desc a1 = v walk=(32, 128)
