fn p12_8x512_r1_rows_o0.l1(x: f16[8192] @dram, y: f16[8192] @dram, v: f16[4096] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send vc[0]
            run put_512_8_2048(1, x + 0, y + 0)
        wait vc[0]
        wait slot 2 n=3 consume
        send vc[0]
            run get_256(2, y + 0, v + 0)
        wait vc[0]
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run put_512_8_2048(1, x + 4096, y + 512)
        wait vc[0]
        ring mesh=0 slot=2 amount=1
    node 2
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run put_512_8_2048(1, x + 8192, y + 1024)
        wait vc[0]
        ring mesh=0 slot=2 amount=1
    node 3
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run put_512_8_2048(1, x + 12288, y + 1536)
        wait vc[0]
        ring mesh=0 slot=2 amount=1

