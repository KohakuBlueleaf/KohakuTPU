target ktpu.v9

image dbl(n, x, y)
    desc a0 = x walk=(32, 64)
    desc a1 = y walk=(32, 64)
    ainc a0 += 2048
    ainc a1 += 2048
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync unpack on=fill
        for j in 0..8
            vunpk v{j} <- l1[j*8] f16
        for j in 0..8
            vadd v{8 + j}, v{j}, v{j}
        for j in 0..8
            vpack v{8 + j} -> l1[64 + j*8] f16
        vsync drain on=pack
        vdrain a1 <- l1[64] rel
        vsync fill on=drain
        vsync pack on=drain
    vsync fe on=drain
    halt

