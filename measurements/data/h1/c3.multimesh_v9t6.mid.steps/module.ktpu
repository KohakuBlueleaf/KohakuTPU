fn c3_vc_p5_one.l1(u0: f16[131072] @dram, u1: f16[131072] @dram, u2: f16[131072] @dram, u3: f16[131072] @dram, v0: f16[131072] @dram, v1: f16[131072] @dram, v2: f16[131072] @dram, v3: f16[131072] @dram, l01: f16[131072] @dram, px0: mx7a[256, 256] @dram(gm=64, nk=2), pw0: mx7b[256, 256] @dram(gn=64, nk=2), slots: u64[5] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send vc[1]
            run dbl(128, u0, v0)
        send mg[1]
            fill A0 <- px0 + 0 n=128
            fill B0 <- pw0 + 0 n=128
            gemm 64x64x2 a=A0 b=B0 acc=0
            fill A1 <- px0 + 16384 n=128
            fill B1 <- pw0 + 16384 n=128
            gemm 64x64x2 a=A1 b=B1 acc=1
            fill A0 <- px0 + 32768 n=128
            fill B0 <- pw0 + 32768 n=128
            gemm 64x64x2 a=A0 b=B0 acc=1
            fill A1 <- px0 + 49152 n=128
            fill B1 <- pw0 + 49152 n=128
            gemm 64x64x2 a=A1 b=B1 acc=1
        send mg[1]
            drain n=256 to=mesh1.vc[0] buf=0 l1=0 count ack=mesh1.vc[0]
        send mg[1]
            drain n=256 to=mesh1.vc[0] buf=0 l1=256 count ack=mesh1.vc[0]
        wait slot 2 n=1 consume
        send mg[1]
            drain n=256 to=mesh1.vc[0] buf=0 l1=0 count ack=mesh1.vc[0]
        wait slot 2 n=1 consume
        send mg[1]
            drain n=256 to=mesh1.vc[0] buf=0 l1=256 count ack=mesh1.vc[0]
        wait slot 2 n=1 consume
        send mg[1]
            drain n=256 to=mesh1.vc[0] buf=0 l1=0 count ack=mesh1.vc[0]
