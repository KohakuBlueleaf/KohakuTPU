target ktpu.v9

image dbl(n, x, y)
    desc a0 = x walk=(32, 64)
    desc a1 = y walk=(32, 64)
    ainc a0 += 2048
    ainc a1 += 2048
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync unpack on=fill
        for j in 0..8
            vunpk v{j} <- l1[j*8] f16
        for j in 0..8
            vadd v{8 + j}, v{j}, v{j}
        for j in 0..8
            vpack v{8 + j} -> l1[64 + j*8] f16
        vsync drain on=pack
        vdrain a1 <- l1[64] rel
        vsync fill on=drain
        vsync pack on=drain
    vsync fe on=drain
    halt

image take_128_0(y)
    desc a0 = y walk=(32, 128)
    vwait drain rx n=128
    vdrain a0 <- l1[0]
    vsync fe on=drain
    halt

image take(n, at, y)
    desc a0 = y walk=(32, n)
    vwait drain rx n=n
    vdrain a0 <- l1[at]
    halt

image put0(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh0.vc[0], count=1, fin=mesh0.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put1(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh1.vc[0], count=1, fin=mesh1.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put2(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh2.vc[0], count=1, fin=mesh2.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put3(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh3.vc[0], count=1, fin=mesh3.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

