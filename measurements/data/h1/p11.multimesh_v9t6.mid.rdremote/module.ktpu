target ktpu.v9

image line(src, dst)
    desc a0 = src walk=(32, 1)
    desc a1 = dst walk=(32, 1)
    vfill a0 -> l1[0]
    vsync drain on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

