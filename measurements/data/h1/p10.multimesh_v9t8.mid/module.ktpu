target ktpu.v9

image rd_2048_2048_4096(n, x, y)
    desc a0 = x walk=(32, 64)
    desc a1 = x + 2048 walk=(32, 64)
    desc a2 = y walk=(32, 64)
    desc a3 = y + 2048 walk=(32, 64)
    ainc a0 += 4096
    ainc a1 += 4096
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vfill a1 -> l1[256] rel
        vsync fe on=fill
    vdrain a2 <- l1[0]
    vdrain a3 <- l1[256]
    vsync fe on=drain
    halt

image rd_8192_8192_16384(n, x, y)
    desc a0 = x walk=(32, 256)
    desc a1 = x + 8192 walk=(32, 256)
    desc a2 = y walk=(32, 256)
    desc a3 = y + 8192 walk=(32, 256)
    ainc a0 += 16384
    ainc a1 += 16384
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vfill a1 -> l1[256] rel
        vsync fe on=fill
    vdrain a2 <- l1[0]
    vdrain a3 <- l1[256]
    vsync fe on=drain
    halt

image rd_8192_8192_65536(n, x, y)
    desc a0 = x walk=(32, 256)
    desc a1 = x + 8192 walk=(32, 256)
    desc a2 = y walk=(32, 256)
    desc a3 = y + 8192 walk=(32, 256)
    ainc a0 += 65536
    ainc a1 += 65536
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vfill a1 -> l1[256] rel
        vsync fe on=fill
    vdrain a2 <- l1[0]
    vdrain a3 <- l1[256]
    vsync fe on=drain
    halt

fn p10_vc_0_4k.l1(x: f16[2048] @dram, y: f16[2048] @dram)
    node 0
        send vc[0]
            run rd_2048_2048_4096(1, x + 0, y + 0)
        wait vc[0]

fn p10_vc_0_4k_warm.l1(x: f16[2048] @dram, y: f16[2048] @dram)
    node 0
        send vc[0]
            run rd_2048_2048_4096(1, x + 0, y + 0)
        wait vc[0]
        send vc[0]
