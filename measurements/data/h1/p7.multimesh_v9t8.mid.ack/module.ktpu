target ktpu.v9

image take(n, at, y)
    desc a0 = y walk=(32, n)
    vwait drain rx n=n
    vdrain a0 <- l1[at]
    halt

image put0(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh0.vc[0], count=1, fin=mesh0.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put1(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh1.vc[0], count=1, fin=mesh1.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put2(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh2.vc[0], count=1, fin=mesh2.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put3(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh3.vc[0], count=1, fin=mesh3.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

fn p7_01_w31.l1(x: f16[496] @dram, y: f16[496] @dram)
    node 0
        wait slot 1 n=1 consume
        ring mesh=1 slot=1 amount=1
        send vc[0]
            run put1(31, 0, x + 0)
        wait vc[0]
        wait slot 2 n=1 consume
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run take(31, 0, y + 0)
        wait vc[0]
        ring mesh=0 slot=2 amount=1

