fn q0_ring_01_a1.l1(unused: u64[4] @dram, slots: u64[1] @dram)
    node 0
        ring mesh=1 slot=1 amount=1
    node 1
        wait slot 1 n=1 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14

