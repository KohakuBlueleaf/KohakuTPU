fn q0_dep_01.l1(x: f16[2048] @dram, y: f16[2048] @dram, z: f16[2048] @dram, seen: u64[2] @dram, slots: u64[2] @dram)
    node 0
        settle 20000
        move
            copy w(x, (128, 32)) -> w(y, (128, 32))
        ring mesh=1 slot=1 amount=1
        wait slot 2 n=1 consume
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        wait slot 1 n=1 consume
        r5 = load y + 0
        store seen + 0 <- r5
        r5 = load y + 4088
        store seen + 8 <- r5
        move
            copy w(y, (128, 32)) -> w(z, (128, 32))
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 8 <- r14

