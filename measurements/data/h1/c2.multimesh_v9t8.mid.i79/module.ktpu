fn c2_mg_w8k_r512_n4_packed.l1(y: f16[8388608] @dram, a: mx7a[64, 64] @dram(gm=16, nk=2), w0: mx7b[32768, 64] @dram(gn=16, nk=2), w1: mx7b[32768, 64] @dram(gn=16, nk=2), w2: mx7b[32768, 64] @dram(gn=16, nk=2), w3: mx7b[32768, 64] @dram(gn=16, nk=2), slots: u64[4] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send mg[0]
            fill A0 <- a + 0 n=32
        r3 = set 0
