image get_256(n, src, v)
    desc a0 = src walk=(32, 256)
    desc a1 = v walk=(32, 256)
    ainc a0 += 8192
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync fe on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

image i79_256_32768_w0(n, src0, dst)
    desc a0 = src0 walk=(32, 256)
    desc a1 = dst walk=((32, 256), (32768, 1))
    ainc a0 += 8192
    ainc a1 += 32768
    seti s0 = n
    seti s1 = 32768.0
    loop s0
        vfill a0 -> l1[0] rel
        vsync unpack on=fill
        for j in 0..16
            vunpk v{j} <- l1[0 + j*8] f16
        for j in 0..16
            vmul v{j}, v{j}, s1
        vsync pack on=unpack
        for j in 0..16
            vpack v{j} -> l1[0 + j*8] f16
        vsync unpack on=pack
        for j in 0..16
            vunpk v{j} <- l1[128 + j*8] f16
        for j in 0..16
            vmul v{j}, v{j}, s1
        vsync pack on=unpack
        for j in 0..16
            vpack v{j} -> l1[128 + j*8] f16
        vsync drain on=pack
        vdrain a1 <- l1[0] rel
        vsync fill on=drain
    halt

