target ktpu.v9

image put_8192_1_32768(n, src, dst)
    desc a0 = src walk=(32, 256)
    desc a1 = dst walk=((32, 256), (32768, 1))
    ainc a0 += 8192
    ainc a1 += 32768
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync drain on=fill
        vdrain a1 <- l1[0] rel
        vsync fill on=drain
    halt

