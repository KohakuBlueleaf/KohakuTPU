target ktpu.v9

image load(n, x)
    desc a0 = x walk=(32, 64)
    ainc a0 += 2048
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync fe on=fill
    halt

fn p8_0_dram_32b.l1(x: f16[16] @dram, y: f16[16] @dram)
    node 0
        move
            copy w(x + 0, (1, 32)) -> w(y + 0, (1, 32))

fn p8_0_dram_1024b.l1(x: f16[512] @dram, y: f16[512] @dram)
    node 0
        move
            copy w(x + 0, (32, 32)) -> w(y + 0, (32, 32))

