target ktpu.v9

fn t_0087f8bc843c60e6d3e548923aa6ac60ff37b651956931bb2847f686b3619764.l2(a: mx7a[624, 64] @dram(gm=13, nk=2), b: mx7b[2688, 64] @dram(gn=56, nk=2), out: f16[624, 224] @dram)
    h1 = buffer  : f16[208, 224] @stage(tile=13x56)
    for k1 in 0..6 pipe=2
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[52, 224] @acc
                for k3 in 0..1
                    a1 = fill a[k1*104 + u1*52 + k2*104 : +52, k3*64 : +64]  : mx7a[52, 64] @A
                    b1 = fill b[k1*448 + u1*224 + k2*448 : +224, k3*64 : +64]  : mx7b[224, 64] @B
                    acc1 = gemm a1, b1, acc1    : f32[52, 224] @acc
                drain acc1 -> h1[(k1 % 2)*104 + u1*52 + k2*104 : +52, 0 : +224]
        par c1 in 0..2 on vc[c1]
            for t1 in 0..6
                xl1 = load h1[(k1 % 2)*104 + c1*52 + t1*8 : +8, 0 : +224]  : f16[8, 224] @l1(gt4)
                v1 = unpack xl1                 : f32[8, 224] @reg(gt4)
                e1 = mul v1, 0.125              : f32[8, 224] @reg(gt4)
                p1 = pack e1                    : f16[8, 224] @l1(gt4)
                store out[k1*104 + c1*52 + t1*8 : +8, 0 : +224] <- p1
        par c2 in 0..2 on vc[c2]
            for t2 in 0..1
                xl2 = load h1[(k1 % 2)*104 + c2*52 + t2*4 + 48 : +4, 0 : +224]  : f16[4, 224] @l1(gt4)
                v2 = unpack xl2                 : f32[4, 224] @reg(gt4)
                e2 = mul v2, 0.125              : f32[4, 224] @reg(gt4)
                p2 = pack e2                    : f16[4, 224] @l1(gt4)
                store out[k1*104 + c2*52 + t2*4 + 48 : +4, 0 : +224] <- p2
