target ktpu.v9

fn t_034e2d6be12685351a53319948eb280edbc66f4dec507159347c568ef04f9a1e.l2(in0: f16[197, 768] @dram, in1: f16[768] @dram, in2: f16[768] @dram, out: f16[197, 768] @dram)
    h1 = buffer  : f16[4, 768] @dram
    h2 = buffer  : f16[4, 768] @dram
    par c1 in 0..2 on vc[c1]
        xl1 = load in1[0 : +768]  : f16[4, 768] @l1(gt4)
        v1 = unpack xl1           : f32[4, 768] @reg(gt4)
        xl2 = load in2[0 : +768]  : f16[4, 768] @l1(gt4)
        v2 = unpack xl2           : f32[4, 768] @reg(gt4)
        for t1 in 0..((c1 + 2) / 2) + 24 - ((c1 + 1) / 2)
            xl3 = load in0[c1*96 + ((c1 + 1) / 2)*4 + t1*4 : +4, 0 : +768]  : f16[4, 768] @l1(gt4)
            v3 = unpack xl3                     : f32[4, 768] @reg(gt4)
            s1 = rsum v3                        : f32[4] @reg
            e1 = mul s1, 0.0013020833333333333  : f32[4] @reg
            e2 = mul e1, -1.0                   : f32[4] @reg
            e3 = add v3, e2[:, *]               : f32[4, 768] @reg(gt4)
            e4 = mul e3, e3                     : f32[4, 768] @reg(gt4)
            s2 = rsum e4                        : f32[4] @reg
            e5 = mul s2, 0.0013020833333333333  : f32[4] @reg
            e6 = add e5, 1e-06                  : f32[4] @reg
            e7 = max e6, 1e-30                  : f32[4] @reg
            e8 = rsqrt e7                       : f32[4] @reg
            e9 = mul e6, e8                     : f32[4] @reg
            e10 = inv e9                        : f32[4] @reg
            e11 = mul e3, e10[:, *]             : f32[4, 768] @reg(gt4)
            e12 = mul e11, v1                   : f32[4, 768] @reg(gt4)
            e13 = add e12, v2                   : f32[4, 768] @reg(gt4)
            p1 = pack e13                       : f16[4, 768] @l1(gt4)
            store out[c1*96 + ((c1 + 1) / 2)*4 + t1*4 : +4, 0 : +768] <- p1
    fill h1 value=0
    copy h1[0 : +1] <- in0[196 : +1, 0 : +768]
    par c2 in 0..1 on vc[c2]
        xl4 = load in1[0 : +768]  : f16[4, 768] @l1(gt4)
        v4 = unpack xl4           : f32[4, 768] @reg(gt4)
        xl5 = load in2[0 : +768]  : f16[4, 768] @l1(gt4)
        v5 = unpack xl5           : f32[4, 768] @reg(gt4)
        for t2 in 0..1
            xl6 = load h1[t2*4 : +4, 0 : +768]  : f16[4, 768] @l1(gt4)
            v6 = unpack xl6                     : f32[4, 768] @reg(gt4)
            s3 = rsum v6                        : f32[4] @reg
            e14 = mul s3, 0.0013020833333333333 : f32[4] @reg
            e15 = mul e14, -1.0                 : f32[4] @reg
            e16 = add v6, e15[:, *]             : f32[4, 768] @reg(gt4)
            e17 = mul e16, e16                  : f32[4, 768] @reg(gt4)
            s4 = rsum e17                       : f32[4] @reg
            e18 = mul s4, 0.0013020833333333333 : f32[4] @reg
            e19 = add e18, 1e-06                : f32[4] @reg
            e20 = max e19, 1e-30                : f32[4] @reg
            e21 = rsqrt e20                     : f32[4] @reg
            e22 = mul e19, e21                  : f32[4] @reg
            e23 = inv e22                       : f32[4] @reg
            e24 = mul e16, e23[:, *]            : f32[4, 768] @reg(gt4)
            e25 = mul e24, v4                   : f32[4, 768] @reg(gt4)
            e26 = add e25, v5                   : f32[4, 768] @reg(gt4)
            p2 = pack e26                       : f16[4, 768] @l1(gt4)
            store h2[t2*4 : +4, 0 : +768] <- p2
    copy out[196 : +1, 0 : +768] <- h2[0 : +1]
