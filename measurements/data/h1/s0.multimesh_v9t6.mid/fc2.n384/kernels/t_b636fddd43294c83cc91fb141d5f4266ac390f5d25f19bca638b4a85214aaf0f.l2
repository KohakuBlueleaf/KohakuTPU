target ktpu.v9

fn t_b636fddd43294c83cc91fb141d5f4266ac390f5d25f19bca638b4a85214aaf0f.l2(a: mx7a[200, 3072] @dram(gm=50, nk=2), b: mx7b[384, 3072] @dram(gn=48, nk=2), in1: f16[200, 384] @dram, in2: f16[384] @dram, out: f16[200, 384] @dram)
    h1 = buffer  : f16[800, 192] @stage(tile=50x48)
    for k1 in 0..1 pipe=2
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 192] @acc
                for k3 in 0..48
                    a1 = fill a[((k1*2 + u1 + k2*2) / 2)*200 + (((k1*2 + u1 + k2*2) % 2) / 2)*200 : +200, k3*64 : +64]  : mx7a[200, 64] @A
                    b1 = fill b[(((k1*2 + u1 + k2*2) % 2) % 2)*192 : +192, k3*64 : +64]  : mx7b[192, 64] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 192] @acc
                drain acc1 -> h1[(k1 % 2)*400 + u1*200 + k2*400 : +200, 0 : +192]
        par c1 in 0..2 on vc[c1]
            xl1 = load in2[(((k1*2 + c1) % 2) % 2)*192 : +192]  : f16[4, 192] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 192] @reg(gt4)
            for t1 in 0..50
                xl2 = load h1[(k1 % 2)*400 + c1*200 + t1*4 : +4, 0 : +192]  : f16[4, 192] @l1(gt4)
                xl3 = load in1[((k1*2 + c1) / 2)*200 + (((k1*2 + c1) % 2) / 2)*200 + t1*4 : +4, (((k1*2 + c1) % 2) % 2)*192 : +192]  : f16[4, 192] @l1(gt4)
                v2 = unpack xl2                 : f32[4, 192] @reg(gt4)
                e1 = add v2, v1                 : f32[4, 192] @reg(gt4)
                v3 = unpack xl3                 : f32[4, 192] @reg(gt4)
                e2 = add v3, e1                 : f32[4, 192] @reg(gt4)
                p1 = pack e2                    : f16[4, 192] @l1(gt4)
                store out[((k1*2 + c1) / 2)*200 + (((k1*2 + c1) % 2) / 2)*200 + t1*4 : +4, (((k1*2 + c1) % 2) % 2)*192 : +192] <- p1
