target ktpu.v9

fn t_8c76bfc1d4d24b3fa50c2b84889e0773bedd56c3bea201f5373b9b3a01ac29b3.l2(a: mx7a[200, 768] @dram(gm=50, nk=2), b: mx7b[768, 768] @dram(gn=48, nk=2), in1: f16[768] @dram, out: f16[200, 768] @dram)
    h1 = buffer  : f16[800, 192] @stage(tile=50x48)
    for k1 in 0..2 pipe=2
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 192] @acc
                for k3 in 0..12
                    a1 = fill a[((k1*2 + u1 + k2*2) / 4)*200 + (((k1*2 + u1 + k2*2) % 4) / 4)*200 : +200, k3*64 : +64]  : mx7a[200, 64] @A
                    b1 = fill b[(((k1*2 + u1 + k2*2) % 4) % 4)*192 : +192, k3*64 : +64]  : mx7b[192, 64] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 192] @acc
                drain acc1 -> h1[(k1 % 2)*400 + u1*200 + k2*400 : +200, 0 : +192]
        par c1 in 0..2 on vc[c1]
            xl1 = load in1[(((k1*2 + c1) % 4) % 4)*192 : +192]  : f16[4, 192] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 192] @reg(gt4)
            for t1 in 0..25
                xl2 = load h1[(k1 % 2)*400 + c1*200 + t1*8 : +8, 0 : +192]  : f16[8, 192] @l1(gt4)
                v2 = unpack xl2                 : f32[8, 192] @reg(gt4)
                e1 = add v2, v1                 : f32[8, 192] @reg(gt4)
                e2 = mul e1, e1                 : f32[8, 192] @reg(gt4)
                e3 = mul e2, e1                 : f32[8, 192] @reg(gt4)
                e4 = mul 0.044715, e3           : f32[8, 192] @reg(gt4)
                e5 = add e1, e4                 : f32[8, 192] @reg(gt4)
                e6 = mul e5, -2.302208198144325 : f32[8, 192] @reg(gt4)
                e7 = exp2 e6                    : f32[8, 192] @reg(gt4)
                e8 = add 1.0, e7                : f32[8, 192] @reg(gt4)
                e9 = inv e8                     : f32[8, 192] @reg(gt4)
                e10 = mul e9, e1                : f32[8, 192] @reg(gt4)
                p1 = pack e10                   : f16[8, 192] @l1(gt4)
                store out[((k1*2 + c1) / 4)*200 + (((k1*2 + c1) % 4) / 4)*200 + t1*8 : +8, (((k1*2 + c1) % 4) % 4)*192 : +192] <- p1
