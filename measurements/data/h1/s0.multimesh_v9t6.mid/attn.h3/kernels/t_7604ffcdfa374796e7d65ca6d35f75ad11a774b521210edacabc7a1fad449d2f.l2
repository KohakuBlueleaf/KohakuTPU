target ktpu.v9

fn t_7604ffcdfa374796e7d65ca6d35f75ad11a774b521210edacabc7a1fad449d2f.l2(a: mx7a[200, 768] @dram(gm=50, nk=2), b: mx7b[576, 768] @dram(gn=24, nk=2), out: f16[200, 576] @dram)
    h1 = buffer  : f16[200, 576] @dram(tile=50x24)
    par u1 in 0..2 on mg[u1]
        for k1 in 0..3
            acc1 = zero  : f32[200, 96] @acc
            for k2 in 0..12
                a1 = fill a[((u1 + k1*2) / 6)*200 : +200, k2*64 : +64]  : mx7a[200, 64] @A
                b1 = fill b[((u1 + k1*2) % 6)*96 : +96, k2*64 : +64]  : mx7b[96, 64] @B
                acc1 = gemm a1, b1, acc1        : f32[200, 96] @acc
            drain acc1 -> h1[((u1 + k1*2) / 6)*200 : +200, ((u1 + k1*2) % 6)*96 : +96]
    par c1 in 0..2 on vc[c1]
        for t1 in 0..((c1 + 2) / 2) + 12 - ((c1 + 1) / 2)
            xl1 = load h1[c1*96 + ((c1 + 1) / 2)*8 + t1*8 : +8, 0 : +96]  : f16[8, 96] @l1(gt4)
            v1 = unpack xl1                     : f32[8, 96] @reg(gt4)
            p1 = pack v1                        : f16[8, 96] @l1(gt4)
            store out[c1*96 + ((c1 + 1) / 2)*8 + t1*8 : +8, 0 : +96] <- p1
    par c2 in 0..2 on vc[c2]
        for t2 in 0..((c2 + 2) / 2) + 12 - ((c2 + 1) / 2)
            xl2 = load h1[c2*96 + ((c2 + 1) / 2)*8 + t2*8 : +8, 96 : +96]  : f16[8, 96] @l1(gt4)
            v2 = unpack xl2                     : f32[8, 96] @reg(gt4)
            p2 = pack v2                        : f16[8, 96] @l1(gt4)
            store out[c2*96 + ((c2 + 1) / 2)*8 + t2*8 : +8, 96 : +96] <- p2
    par c3 in 0..2 on vc[c3]
        for t3 in 0..((c3 + 2) / 2) + 12 - ((c3 + 1) / 2)
            xl3 = load h1[c3*96 + ((c3 + 1) / 2)*8 + t3*8 : +8, 192 : +96]  : f16[8, 96] @l1(gt4)
            v3 = unpack xl3                     : f32[8, 96] @reg(gt4)
            p3 = pack v3                        : f16[8, 96] @l1(gt4)
            store out[c3*96 + ((c3 + 1) / 2)*8 + t3*8 : +8, 192 : +96] <- p3
    par c4 in 0..2 on vc[c4]
        for t4 in 0..((c4 + 2) / 2) + 12 - ((c4 + 1) / 2)
            xl4 = load h1[c4*96 + ((c4 + 1) / 2)*8 + t4*8 : +8, 288 : +96]  : f16[8, 96] @l1(gt4)
            v4 = unpack xl4                     : f32[8, 96] @reg(gt4)
            p4 = pack v4                        : f16[8, 96] @l1(gt4)
            store out[c4*96 + ((c4 + 1) / 2)*8 + t4*8 : +8, 288 : +96] <- p4
    par c5 in 0..2 on vc[c5]
        for t5 in 0..((c5 + 2) / 2) + 12 - ((c5 + 1) / 2)
            xl5 = load h1[c5*96 + ((c5 + 1) / 2)*8 + t5*8 : +8, 384 : +96]  : f16[8, 96] @l1(gt4)
            v5 = unpack xl5                     : f32[8, 96] @reg(gt4)
            p5 = pack v5                        : f16[8, 96] @l1(gt4)
            store out[c5*96 + ((c5 + 1) / 2)*8 + t5*8 : +8, 384 : +96] <- p5
    par c6 in 0..2 on vc[c6]
        for t6 in 0..((c6 + 2) / 2) + 12 - ((c6 + 1) / 2)
            xl6 = load h1[c6*96 + ((c6 + 1) / 2)*8 + t6*8 : +8, 480 : +96]  : f16[8, 96] @l1(gt4)
            v6 = unpack xl6                     : f32[8, 96] @reg(gt4)
            p6 = pack v6                        : f16[8, 96] @l1(gt4)
            store out[c6*96 + ((c6 + 1) / 2)*8 + t6*8 : +8, 480 : +96] <- p6
