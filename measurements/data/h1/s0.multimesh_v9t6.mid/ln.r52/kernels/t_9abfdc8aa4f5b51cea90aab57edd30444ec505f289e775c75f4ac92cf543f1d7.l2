target ktpu.v9

fn t_9abfdc8aa4f5b51cea90aab57edd30444ec505f289e775c75f4ac92cf543f1d7.l2(in0: f16[52, 768] @dram, in1: f16[768] @dram, in2: f16[768] @dram, out: f16[52, 768] @dram)
    par c1 in 0..2 on vc[c1]
        xl1 = load in1[0 : +768]  : f16[4, 768] @l1(gt4)
        v1 = unpack xl1           : f32[4, 768] @reg(gt4)
        xl2 = load in2[0 : +768]  : f16[4, 768] @l1(gt4)
        v2 = unpack xl2           : f32[4, 768] @reg(gt4)
        for t1 in 0..((c1 + 2) / 2) + 6 - ((c1 + 1) / 2)
            xl3 = load in0[c1*24 + ((c1 + 1) / 2)*4 + t1*4 : +4, 0 : +768]  : f16[4, 768] @l1(gt4)
            v3 = unpack xl3                     : f32[4, 768] @reg(gt4)
            s1 = rsum v3                        : f32[4] @reg
            e1 = mul s1, 0.0013020833333333333  : f32[4] @reg
            e2 = mul e1, -1.0                   : f32[4] @reg
            e3 = add v3, e2[:, *]               : f32[4, 768] @reg(gt4)
            e4 = mul e3, e3                     : f32[4, 768] @reg(gt4)
            s2 = rsum e4                        : f32[4] @reg
            e5 = mul s2, 0.0013020833333333333  : f32[4] @reg
            e6 = add e5, 1e-06                  : f32[4] @reg
            e7 = max e6, 1e-30                  : f32[4] @reg
            e8 = rsqrt e7                       : f32[4] @reg
            e9 = mul e6, e8                     : f32[4] @reg
            e10 = inv e9                        : f32[4] @reg
            e11 = mul e3, e10[:, *]             : f32[4, 768] @reg(gt4)
            e12 = mul e11, v1                   : f32[4, 768] @reg(gt4)
            e13 = add e12, v2                   : f32[4, 768] @reg(gt4)
            p1 = pack e13                       : f16[4, 768] @l1(gt4)
            store out[c1*24 + ((c1 + 1) / 2)*4 + t1*4 : +4, 0 : +768] <- p1
