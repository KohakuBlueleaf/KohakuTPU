target ktpu.v9

fn t_61dac1316622f7fc8d0ecbff33cc621d86376670b423aa0e427d79d5f39f5b7a.l2(a: mx7a[200, 768] @dram(gm=50, nk=2), b: mx7b[1152, 768] @dram(gn=48, nk=2), in1: f16[1152] @dram, out: f16[200, 1152] @dram)
    h1 = buffer  : f16[800, 192] @stage(tile=50x48)
    for k1 in 0..3 pipe=2
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 192] @acc
                for k3 in 0..12
                    a1 = fill a[((k1*2 + u1 + k2*2) / 6)*200 + (((k1*2 + u1 + k2*2) % 6) / 6)*200 : +200, k3*64 : +64]  : mx7a[200, 64] @A
                    b1 = fill b[(((k1*2 + u1 + k2*2) % 6) % 6)*192 : +192, k3*64 : +64]  : mx7b[192, 64] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 192] @acc
                drain acc1 -> h1[(k1 % 2)*400 + u1*200 + k2*400 : +200, 0 : +192]
        par c1 in 0..2 on vc[c1]
            xl1 = load in1[(((k1*2 + c1) % 6) % 6)*192 : +192]  : f16[4, 192] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 192] @reg(gt4)
            for t1 in 0..25
                xl2 = load h1[(k1 % 2)*400 + c1*200 + t1*8 : +8, 0 : +192]  : f16[8, 192] @l1(gt4)
                v2 = unpack xl2                 : f32[8, 192] @reg(gt4)
                e1 = add v2, v1                 : f32[8, 192] @reg(gt4)
                p1 = pack e1                    : f16[8, 192] @l1(gt4)
                store out[((k1*2 + c1) / 6)*200 + (((k1*2 + c1) % 6) / 6)*200 + t1*8 : +8, (((k1*2 + c1) % 6) % 6)*192 : +192] <- p1
