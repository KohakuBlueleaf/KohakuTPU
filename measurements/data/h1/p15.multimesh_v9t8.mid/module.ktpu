target ktpu.v9

image one(x, y)
    desc a0 = x walk=(32, 1)
    desc a1 = y walk=(32, 1)
    vfill a0 -> l1[0]
    vsync drain on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

image pad0(x, y)
    desc a0 = x walk=(32, 1)
    desc a1 = y walk=(32, 1)
    vfill a0 -> l1[0]
    vsync drain on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

