fn p15_0123_group_n1.l1(x: f16[16] @dram, y: f16[64] @dram, slots: u64[4] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send vc[0]
            run one(x + 0, y + 0)
        wait vc[0]
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run one(x + 0, y + 32)
        wait vc[0]
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 8 <- r14
    node 2
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run one(x + 0, y + 64)
        wait vc[0]
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 16 <- r14
    node 3
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run one(x + 0, y + 96)
        wait vc[0]
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 24 <- r14

