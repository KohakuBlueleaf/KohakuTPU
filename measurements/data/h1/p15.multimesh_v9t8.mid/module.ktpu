fn p15_01_empty.l1(unused: u64[4] @dram, slots: u64[2] @dram)
    node 0
        wait slot 1 n=1 consume
        ring mesh=1 slot=1 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 8 <- r14

fn p15_01_sends_n1.l1(x: f16[16] @dram, y: f16[32] @dram, slots: u64[2] @dram)
