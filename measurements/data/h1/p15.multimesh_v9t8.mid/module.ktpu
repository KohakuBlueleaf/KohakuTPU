fn p15_0_empty.l1(unused: u64[4] @dram)
    node 0

fn p15_0_sends_n1.l1(x: f16[16] @dram, y: f16[16] @dram)
    node 0
        send vc[0]
            run one(x + 0, y + 0)
        wait vc[0]

