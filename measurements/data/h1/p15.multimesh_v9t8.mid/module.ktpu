fn p15_0123_empty.l1(unused: u64[4] @dram, slots: u64[4] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 8 <- r14
    node 2
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 16 <- r14
    node 3
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 24 <- r14

