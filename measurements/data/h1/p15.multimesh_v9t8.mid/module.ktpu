fn p15_image_pad0.l1(x: f16[128] @dram, y: f16[128] @dram)
    node 0
        send vc[0]
            run pad0(x + 0, y + 0)
        send vc[0]
            run pad0(x + 32, y + 32)
        send vc[0]
            run pad0(x + 64, y + 64)
        send vc[0]
            run pad0(x + 96, y + 96)
        send vc[0]
            run pad0(x + 128, y + 128)
        send vc[0]
            run pad0(x + 160, y + 160)
        send vc[0]
            run pad0(x + 192, y + 192)
        send vc[0]
            run pad0(x + 224, y + 224)
        wait vc[0]

fn p15_image_pad32.l1(x: f16[128] @dram, y: f16[128] @dram)
    node 0
        send vc[0]
            run pad32(x + 0, y + 0)
        send vc[0]
            run pad32(x + 32, y + 32)
        send vc[0]
            run pad32(x + 64, y + 64)
        send vc[0]
            run pad32(x + 96, y + 96)
        send vc[0]
            run pad32(x + 128, y + 128)
        send vc[0]
            run pad32(x + 160, y + 160)
        send vc[0]
            run pad32(x + 192, y + 192)
        send vc[0]
            run pad32(x + 224, y + 224)
        wait vc[0]

fn p15_image_pad128.l1(x: f16[128] @dram, y: f16[128] @dram)
    node 0
        send vc[0]
            run pad128(x + 0, y + 0)
        send vc[0]
            run pad128(x + 32, y + 32)
        send vc[0]
            run pad128(x + 64, y + 64)
        send vc[0]
            run pad128(x + 96, y + 96)
        send vc[0]
            run pad128(x + 128, y + 128)
        send vc[0]
            run pad128(x + 160, y + 160)
        send vc[0]
            run pad128(x + 192, y + 192)
        send vc[0]
            run pad128(x + 224, y + 224)
        wait vc[0]
