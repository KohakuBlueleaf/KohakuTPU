fn p15_0123_repeat_n1.l1(x: f16[16] @dram, y: f16[64] @dram, slots: u64[4] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send vc[0] repeats=1 advances=((0, 32), (1, 32))
            run one(x, y + 0)
        wait vc[0]
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0] repeats=1 advances=((0, 32), (1, 32))
            run one(x, y + 32)
