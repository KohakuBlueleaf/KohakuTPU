        store slots + 8 <- r14
    node 2
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0] repeats=1 advances=((0, 32), (1, 32))
            run one(x, y + 64)
        wait vc[0]
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 16 <- r14
    node 3
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0] repeats=1 advances=((0, 32), (1, 32))
