target ktpu.v9

fn t_0813696c4bded6b096a77606620fccd4f7a4c773abf2a29ebf779cc6ca9a6b9a.l2(a: mx7a[200, 768] @dram(gm=50, nk=1), b: mx7b[3072, 768] @dram(gn=64, nk=1), in1: f16[3072] @dram, out: f16[200, 3072] @dram)
    h1 = buffer  : f16[1600, 256] @stage(tile=50x64)
    for k1 in 0..3 pipe=2
        par u1 in 0..4 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 256] @acc
                for k3 in 0..24
                    a1 = fill a[((k1*4 + u1 + k2*4) / 12)*200 + (((k1*4 + u1 + k2*4) % 12) / 12)*200 : +200, k3*32 : +32]  : mx7a[200, 32] @A
                    b1 = fill b[(((k1*4 + u1 + k2*4) % 12) % 12)*256 : +256, k3*32 : +32]  : mx7b[256, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 256] @acc
                drain acc1 -> h1[(k1 % 2)*800 + u1*200 + k2*800 : +200, 0 : +256]
        par c1 in 0..4 on vc[any]
            xl1 = load in1[(((k1*4 + c1) % 12) % 12)*256 : +256]  : f16[4, 256] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 256] @reg(gt4)
            for t1 in 0..50
                xl2 = load h1[(k1 % 2)*800 + c1*200 + t1*4 : +4, 0 : +256]  : f16[4, 256] @l1(gt4)
                v2 = unpack xl2                 : f32[4, 256] @reg(gt4)
                e1 = add v2, v1                 : f32[4, 256] @reg(gt4)
                e2 = mul e1, e1                 : f32[4, 256] @reg(gt4)
                e3 = mul e2, e1                 : f32[4, 256] @reg(gt4)
                e4 = mul 0.044715, e3           : f32[4, 256] @reg(gt4)
                e5 = add e1, e4                 : f32[4, 256] @reg(gt4)
                e6 = mul e5, -2.302208198144325 : f32[4, 256] @reg(gt4)
                e7 = exp2 e6                    : f32[4, 256] @reg(gt4)
                e8 = add 1.0, e7                : f32[4, 256] @reg(gt4)
                e9 = inv e8                     : f32[4, 256] @reg(gt4)
                e10 = mul e9, e1                : f32[4, 256] @reg(gt4)
                p1 = pack e10                   : f16[4, 256] @l1(gt4)
                store out[((k1*4 + c1) / 12)*200 + (((k1*4 + c1) % 12) / 12)*200 + t1*4 : +4, (((k1*4 + c1) % 12) % 12)*256 : +256] <- p1
