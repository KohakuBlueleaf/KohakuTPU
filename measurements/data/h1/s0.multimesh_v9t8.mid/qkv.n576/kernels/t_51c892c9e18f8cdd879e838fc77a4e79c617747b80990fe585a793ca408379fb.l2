target ktpu.v9

fn t_51c892c9e18f8cdd879e838fc77a4e79c617747b80990fe585a793ca408379fb.l2(a: mx7a[200, 768] @dram(gm=50, nk=1), b: mx7b[576, 768] @dram(gn=48, nk=1), in1: f16[576] @dram, out: f16[200, 576] @dram)
    h1 = buffer  : f16[1200, 192] @stage(tile=50x48)
    for k1 in 0..1 pipe=2
        par u1 in 0..3 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 192] @acc
                for k3 in 0..24
                    a1 = fill a[((k1*3 + u1 + k2*3) / 3)*200 + (((k1*3 + u1 + k2*3) % 3) / 3)*200 : +200, k3*32 : +32]  : mx7a[200, 32] @A
                    b1 = fill b[(((k1*3 + u1 + k2*3) % 3) % 3)*192 : +192, k3*32 : +32]  : mx7b[192, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 192] @acc
                drain acc1 -> h1[(k1 % 2)*600 + u1*200 + k2*600 : +200, 0 : +192]
        par c1 in 0..3 on vc[any]
            xl1 = load in1[(((k1*3 + c1) % 3) % 3)*192 : +192]  : f16[4, 192] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 192] @reg(gt4)
            for t1 in 0..25
                xl2 = load h1[(k1 % 2)*600 + c1*200 + t1*8 : +8, 0 : +192]  : f16[8, 192] @l1(gt4)
                v2 = unpack xl2                 : f32[8, 192] @reg(gt4)
                e1 = add v2, v1                 : f32[8, 192] @reg(gt4)
                p1 = pack e1                    : f16[8, 192] @l1(gt4)
                store out[((k1*3 + c1) / 3)*200 + (((k1*3 + c1) % 3) / 3)*200 + t1*8 : +8, (((k1*3 + c1) % 3) % 3)*192 : +192] <- p1
