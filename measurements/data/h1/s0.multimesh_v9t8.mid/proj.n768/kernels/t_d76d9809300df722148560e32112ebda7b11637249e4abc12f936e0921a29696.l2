target ktpu.v9

fn t_d76d9809300df722148560e32112ebda7b11637249e4abc12f936e0921a29696.l2(a: mx7a[200, 768] @dram(gm=50, nk=1), b: mx7b[768, 768] @dram(gn=48, nk=1), in1: f16[200, 768] @dram, in2: f16[768] @dram, out: f16[200, 768] @dram)
    h1 = buffer  : f16[1600, 192] @stage(tile=50x48)
    for k1 in 0..1 pipe=2
        par u1 in 0..4 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 192] @acc
                for k3 in 0..24
                    a1 = fill a[((k1*4 + u1 + k2*4) / 4)*200 + (((k1*4 + u1 + k2*4) % 4) / 4)*200 : +200, k3*32 : +32]  : mx7a[200, 32] @A
                    b1 = fill b[(((k1*4 + u1 + k2*4) % 4) % 4)*192 : +192, k3*32 : +32]  : mx7b[192, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 192] @acc
                drain acc1 -> h1[(k1 % 2)*800 + u1*200 + k2*800 : +200, 0 : +192]
        par c1 in 0..4 on vc[any]
            xl1 = load in2[(((k1*4 + c1) % 4) % 4)*192 : +192]  : f16[4, 192] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 192] @reg(gt4)
            for t1 in 0..50
                xl2 = load h1[(k1 % 2)*800 + c1*200 + t1*4 : +4, 0 : +192]  : f16[4, 192] @l1(gt4)
                xl3 = load in1[((k1*4 + c1) / 4)*200 + (((k1*4 + c1) % 4) / 4)*200 + t1*4 : +4, (((k1*4 + c1) % 4) % 4)*192 : +192]  : f16[4, 192] @l1(gt4)
                v2 = unpack xl2                 : f32[4, 192] @reg(gt4)
                e1 = add v2, v1                 : f32[4, 192] @reg(gt4)
                v3 = unpack xl3                 : f32[4, 192] @reg(gt4)
                e2 = add v3, e1                 : f32[4, 192] @reg(gt4)
                p1 = pack e2                    : f16[4, 192] @l1(gt4)
                store out[((k1*4 + c1) / 4)*200 + (((k1*4 + c1) % 4) / 4)*200 + t1*4 : +4, (((k1*4 + c1) % 4) % 4)*192 : +192] <- p1
