target ktpu.v9

fn t_1350474e3b89d6fac3187d5d743e48aefc2f73fde87e8023a97410be5f6c3f29.l2(a: mx7a[200, 768] @dram(gm=50, nk=1), b: mx7b[768, 768] @dram(gn=48, nk=1), in1: f16[768] @dram, out: f16[200, 768] @dram)
    h1 = buffer  : f16[1600, 192] @stage(tile=50x48)
    for k1 in 0..1 pipe=2
        par u1 in 0..4 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 192] @acc
                for k3 in 0..24
                    a1 = fill a[((k1*4 + u1 + k2*4) / 4)*200 + (((k1*4 + u1 + k2*4) % 4) / 4)*200 : +200, k3*32 : +32]  : mx7a[200, 32] @A
                    b1 = fill b[(((k1*4 + u1 + k2*4) % 4) % 4)*192 : +192, k3*32 : +32]  : mx7b[192, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 192] @acc
                drain acc1 -> h1[(k1 % 2)*800 + u1*200 + k2*800 : +200, 0 : +192]
        par c1 in 0..4 on vc[any]
            xl1 = load in1[(((k1*4 + c1) % 4) % 4)*192 : +192]  : f16[4, 192] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 192] @reg(gt4)
            for t1 in 0..25
                xl2 = load h1[(k1 % 2)*800 + c1*200 + t1*8 : +8, 0 : +192]  : f16[8, 192] @l1(gt4)
                v2 = unpack xl2                 : f32[8, 192] @reg(gt4)
                e1 = add v2, v1                 : f32[8, 192] @reg(gt4)
                e2 = mul e1, e1                 : f32[8, 192] @reg(gt4)
                e3 = mul e2, e1                 : f32[8, 192] @reg(gt4)
                e4 = mul 0.044715, e3           : f32[8, 192] @reg(gt4)
                e5 = add e1, e4                 : f32[8, 192] @reg(gt4)
                e6 = mul e5, -2.302208198144325 : f32[8, 192] @reg(gt4)
                e7 = exp2 e6                    : f32[8, 192] @reg(gt4)
                e8 = add 1.0, e7                : f32[8, 192] @reg(gt4)
                e9 = inv e8                     : f32[8, 192] @reg(gt4)
                e10 = mul e9, e1                : f32[8, 192] @reg(gt4)
                p1 = pack e10                   : f16[8, 192] @l1(gt4)
                store out[((k1*4 + c1) / 4)*200 + (((k1*4 + c1) % 4) / 4)*200 + t1*8 : +8, (((k1*4 + c1) % 4) % 4)*192 : +192] <- p1
