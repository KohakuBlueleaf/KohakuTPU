target ktpu.v9

fn t_0fc2534270c45147728f9f1ee79c84fb4aa13680938365868b5056d0298911ba.l2(a: mx7a[200, 3072] @dram(gm=50, nk=1), b: mx7b[192, 3072] @dram(gn=16, nk=1), in1: f16[200, 192] @dram, in2: f16[192] @dram, out: f16[200, 192] @dram)
    h1 = buffer  : f16[1200, 64] @stage(tile=50x16)
    for k1 in 0..1 pipe=2
        par u1 in 0..3 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 64] @acc
                for k3 in 0..96
                    a1 = fill a[((k1*3 + u1 + k2*3) / 3)*200 + (((k1*3 + u1 + k2*3) % 3) / 3)*200 : +200, k3*32 : +32]  : mx7a[200, 32] @A
                    b1 = fill b[(((k1*3 + u1 + k2*3) % 3) % 3)*64 : +64, k3*32 : +32]  : mx7b[64, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 64] @acc
                drain acc1 -> h1[(k1 % 2)*600 + u1*200 + k2*600 : +200, 0 : +64]
        par c1 in 0..3 on vc[any]
            xl1 = load in2[(((k1*3 + c1) % 3) % 3)*64 : +64]  : f16[4, 64] @l1(gt4)
            v1 = unpack xl1                     : f32[4, 64] @reg(gt4)
            for t1 in 0..12
                xl2 = load h1[(k1 % 2)*600 + c1*200 + t1*16 : +16, 0 : +64]  : f16[16, 64] @l1(gt4)
                xl3 = load in1[((k1*3 + c1) / 3)*200 + (((k1*3 + c1) % 3) / 3)*200 + t1*16 : +16, (((k1*3 + c1) % 3) % 3)*64 : +64]  : f16[16, 64] @l1(gt4)
                v2 = unpack xl2                 : f32[16, 64] @reg(gt4)
                e1 = add v2, v1                 : f32[16, 64] @reg(gt4)
                v3 = unpack xl3                 : f32[16, 64] @reg(gt4)
                e2 = add v3, e1                 : f32[16, 64] @reg(gt4)
                p1 = pack e2                    : f16[16, 64] @l1(gt4)
                store out[((k1*3 + c1) / 3)*200 + (((k1*3 + c1) % 3) / 3)*200 + t1*16 : +16, (((k1*3 + c1) % 3) % 3)*64 : +64] <- p1
        par c2 in 0..3 on vc[any]
            xl4 = load in2[(((k1*3 + c2) % 3) % 3)*64 : +64]  : f16[4, 64] @l1(gt4)
            v4 = unpack xl4                     : f32[4, 64] @reg(gt4)
            for t2 in 0..1
                xl5 = load h1[(k1 % 2)*600 + c2*200 + t2*8 + 192 : +8, 0 : +64]  : f16[8, 64] @l1(gt4)
                xl6 = load in1[((k1*3 + c2) / 3)*200 + (((k1*3 + c2) % 3) / 3)*200 + t2*8 + 192 : +8, (((k1*3 + c2) % 3) % 3)*64 : +64]  : f16[8, 64] @l1(gt4)
                v5 = unpack xl5                 : f32[8, 64] @reg(gt4)
                e3 = add v5, v4                 : f32[8, 64] @reg(gt4)
                v6 = unpack xl6                 : f32[8, 64] @reg(gt4)
                e4 = add v6, e3                 : f32[8, 64] @reg(gt4)
                p2 = pack e4                    : f16[8, 64] @l1(gt4)
                store out[((k1*3 + c2) / 3)*200 + (((k1*3 + c2) % 3) / 3)*200 + t2*8 + 192 : +8, (((k1*3 + c2) % 3) % 3)*64 : +64] <- p2
