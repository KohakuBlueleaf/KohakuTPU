            e1 = mul s1, -1.0                   : f32[8] @reg
            e2 = add v2, e1[:, *]               : f32[8, 224] @reg(gt4)
            e3 = mul e2, 1.4426950408889634     : f32[8, 224] @reg(gt4)
            e4 = exp2 e3                        : f32[8, 224] @reg(gt4)
            o2 = sel v1, e4, 0.0                : f32[8, 224] @reg(gt4)
            s2 = rsum o2                        : f32[8] @reg
            e5 = inv s2                         : f32[8] @reg
            e6 = mul e4, e5[:, *]               : f32[8, 224] @reg(gt4)
            p1 = pack e6                        : f16[8, 224] @l1(gt4)
            store out[c1*288 + ((c1 + 1) / 2)*8 + t1*8 : +8, 0 : +224] <- p1
    par c2 in 0..1 on vc[c2]
        xl3 = load in1[0 : +224]  : f16[4, 224] @l1(gt4)
        v3 = unpack xl3           : f32[4, 224] @reg(gt4)
        for t2 in 0..1
            xl4 = load in0[t2*4 + 584 : +4, 0 : +224]  : f16[4, 224] @l1(gt4)
            v4 = unpack xl4                     : f32[4, 224] @reg(gt4)
            o3 = sel v3, v4, -65504.0           : f32[4, 224] @reg(gt4)
            s3 = rmax o3                        : f32[4] @reg
            e7 = mul s3, -1.0                   : f32[4] @reg
            e8 = add v4, e7[:, *]               : f32[4, 224] @reg(gt4)
            e9 = mul e8, 1.4426950408889634     : f32[4, 224] @reg(gt4)
