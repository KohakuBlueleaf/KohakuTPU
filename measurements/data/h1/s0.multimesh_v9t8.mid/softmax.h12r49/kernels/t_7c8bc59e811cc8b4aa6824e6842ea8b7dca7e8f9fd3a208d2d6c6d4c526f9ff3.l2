target ktpu.v9

fn t_7c8bc59e811cc8b4aa6824e6842ea8b7dca7e8f9fd3a208d2d6c6d4c526f9ff3.l2(in0: f16[588, 224] @dram, in1: f16[224] @dram, out: f16[588, 224] @dram)
    par c1 in 0..2 on vc[c1]
        xl1 = load in1[0 : +224]  : f16[4, 224] @l1(gt4)
        v1 = unpack xl1           : f32[4, 224] @reg(gt4)
        for t1 in 0..((c1 + 2) / 2) + 36 - ((c1 + 1) / 2)
            xl2 = load in0[c1*288 + ((c1 + 1) / 2)*8 + t1*8 : +8, 0 : +224]  : f16[8, 224] @l1(gt4)
