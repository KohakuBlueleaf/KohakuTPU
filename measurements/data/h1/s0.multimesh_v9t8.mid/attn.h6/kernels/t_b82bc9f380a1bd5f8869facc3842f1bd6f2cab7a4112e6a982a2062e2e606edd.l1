fn t_b82bc9f380a1bd5f8869facc3842f1bd6f2cab7a4112e6a982a2062e2e606edd.l1(a: mx7a[200, 768] @dram(gm=50, nk=1), b: mx7b[1152, 768] @dram(gn=24, nk=1), out: f16[200, 1152] @dram, h1: f16[200, 1152] @dram(tile=50x24))
    send mg[0]
        fill A0 <- a+0 n=50
        fill B0 <- b+0 n=24
