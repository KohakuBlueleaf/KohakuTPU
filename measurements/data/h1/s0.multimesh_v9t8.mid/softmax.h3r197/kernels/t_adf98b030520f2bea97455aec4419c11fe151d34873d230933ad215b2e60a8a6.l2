target ktpu.v9

fn t_adf98b030520f2bea97455aec4419c11fe151d34873d230933ad215b2e60a8a6.l2(a: mx7a[600, 64] @dram(gm=50, nk=1), b: mx7b[672, 64] @dram(gn=56, nk=1), out: f16[600, 224] @dram)
    h1 = buffer  : f16[1200, 224] @stage(tile=50x56)
    for k1 in 0..1 pipe=2
        par u1 in 0..3 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 224] @acc
                for k3 in 0..2
                    a1 = fill a[k1*600 + u1*200 + k2*600 : +200, k3*32 : +32]  : mx7a[200, 32] @A
                    b1 = fill b[k1*672 + u1*224 + k2*672 : +224, k3*32 : +32]  : mx7b[224, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 224] @acc
                drain acc1 -> h1[(k1 % 2)*600 + u1*200 + k2*600 : +200, 0 : +224]
        par c1 in 0..3 on vc[any]
            for t1 in 0..25
                xl1 = load h1[(k1 % 2)*600 + c1*200 + t1*8 : +8, 0 : +224]  : f16[8, 224] @l1(gt4)
                v1 = unpack xl1                 : f32[8, 224] @reg(gt4)
                e1 = mul v1, 0.125              : f32[8, 224] @reg(gt4)
                p1 = pack e1                    : f16[8, 224] @l1(gt4)
                store out[k1*600 + c1*200 + t1*8 : +8, 0 : +224] <- p1
