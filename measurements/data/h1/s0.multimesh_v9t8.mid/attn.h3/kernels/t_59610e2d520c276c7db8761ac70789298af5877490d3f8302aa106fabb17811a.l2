target ktpu.v9

fn t_59610e2d520c276c7db8761ac70789298af5877490d3f8302aa106fabb17811a.l2(a: mx7a[600, 224] @dram(gm=50, nk=1), b: mx7b[192, 224] @dram(gn=16, nk=1), out: f16[600, 64] @dram)
    h1 = buffer  : f16[600, 64] @dram(tile=50x16)
    par u1 in 0..3 on mg[u1]
        for k1 in 0..1
            acc1 = zero  : f32[200, 64] @acc
            for k2 in 0..7
                a1 = fill a[u1*200 + k1*600 : +200, k2*32 : +32]  : mx7a[200, 32] @A
                b1 = fill b[u1*64 + k1*192 : +64, k2*32 : +32]  : mx7b[64, 32] @B
                acc1 = gemm a1, b1, acc1        : f32[200, 64] @acc
            drain acc1 -> h1[u1*200 + k1*600 : +200, 0 : +64]
    for k3 in 0..3
        par c1 in 0..2 on vc[c1]
            for t1 in 0..((c1 + 2) / 2) + 12 - ((c1 + 1) / 2)
                xl1 = load h1[c1*96 + ((c1 + 1) / 2)*8 + t1*8 + k3*200 : +8, 0 : +64]  : f16[8, 64] @l1(gt4)
                v1 = unpack xl1                 : f32[8, 64] @reg(gt4)
                p1 = pack v1                    : f16[8, 64] @l1(gt4)
                store out[c1*96 + ((c1 + 1) / 2)*8 + t1*8 + k3*200 : +8, 0 : +64] <- p1
