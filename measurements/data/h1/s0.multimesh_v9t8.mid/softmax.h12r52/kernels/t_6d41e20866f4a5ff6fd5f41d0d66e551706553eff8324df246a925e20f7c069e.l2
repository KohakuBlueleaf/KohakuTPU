target ktpu.v9

fn t_6d41e20866f4a5ff6fd5f41d0d66e551706553eff8324df246a925e20f7c069e.l2(a: mx7a[624, 64] @dram(gm=13, nk=1), b: mx7b[2688, 64] @dram(gn=56, nk=1), out: f16[624, 224] @dram)
    h1 = buffer  : f16[416, 224] @stage(tile=13x56)
    for k1 in 0..3 pipe=2
        par u1 in 0..4 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[52, 224] @acc
                for k3 in 0..2
                    a1 = fill a[k1*208 + u1*52 + k2*208 : +52, k3*32 : +32]  : mx7a[52, 32] @A
                    b1 = fill b[k1*896 + u1*224 + k2*896 : +224, k3*32 : +32]  : mx7b[224, 32] @B
                    acc1 = gemm a1, b1, acc1    : f32[52, 224] @acc
                drain acc1 -> h1[(k1 % 2)*208 + u1*52 + k2*208 : +52, 0 : +224]
        par c1 in 0..4 on vc[any]
            for t1 in 0..6
                xl1 = load h1[(k1 % 2)*208 + c1*52 + t1*8 : +8, 0 : +224]  : f16[8, 224] @l1(gt4)
                v1 = unpack xl1                 : f32[8, 224] @reg(gt4)
                e1 = mul v1, 0.125              : f32[8, 224] @reg(gt4)
                p1 = pack e1                    : f16[8, 224] @l1(gt4)
                store out[k1*208 + c1*52 + t1*8 : +8, 0 : +224] <- p1
        par c2 in 0..4 on vc[any]
            for t2 in 0..1
                xl2 = load h1[(k1 % 2)*208 + c2*52 + t2*4 + 48 : +4, 0 : +224]  : f16[4, 224] @l1(gt4)
                v2 = unpack xl2                 : f32[4, 224] @reg(gt4)
                e2 = mul v2, 0.125              : f32[4, 224] @reg(gt4)
                p2 = pack e2                    : f16[4, 224] @l1(gt4)
                store out[k1*208 + c2*52 + t2*4 + 48 : +4, 0 : +224] <- p2
