target ktpu.v9

image vsum2(n, p0, p1, bias, res, z)
    desc a0 = p0 walk=(32, 16)
    desc a1 = p1 walk=(32, 16)
    desc a2 = bias walk=(32, 16)
    desc a3 = res walk=(32, 16)
    desc a4 = z walk=(32, 16)
    ainc a0 += 512
    ainc a1 += 512
    ainc a2 += 512
    ainc a3 += 512
    ainc a4 += 512
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vfill a1 -> l1[16] rel
        vfill a2 -> l1[32] rel
        vfill a3 -> l1[48] rel
        vsync unpack on=fill
        vunpk v0 <- l1[0] f16
        vunpk v2 <- l1[16] f16
        vunpk v4 <- l1[32] f16
        vunpk v6 <- l1[48] f16
        vadd v8, v0, v2
        vadd v10, v8, v4
        vadd v12, v10, v6
        vpack v12 -> l1[64] f16
        vunpk v1 <- l1[8] f16
        vunpk v3 <- l1[24] f16
        vunpk v5 <- l1[40] f16
        vunpk v7 <- l1[56] f16
        vadd v9, v1, v3
        vadd v11, v9, v5
        vadd v13, v11, v7
        vpack v13 -> l1[72] f16
        vsync drain on=pack
        vdrain a4 <- l1[64] rel
        vsync fill on=drain
        vsync pack on=drain
    vsync fe on=drain
    halt

image vsum4(n, p0, p1, p2, p3, bias, res, z)
    desc a0 = p0 walk=(32, 16)
    desc a1 = p1 walk=(32, 16)
    desc a2 = p2 walk=(32, 16)
    desc a3 = p3 walk=(32, 16)
    desc a4 = bias walk=(32, 16)
    desc a5 = res walk=(32, 16)
    desc a6 = z walk=(32, 16)
    ainc a0 += 512
    ainc a1 += 512
    ainc a2 += 512
    ainc a3 += 512
    ainc a4 += 512
    ainc a5 += 512
    ainc a6 += 512
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vfill a1 -> l1[16] rel
        vfill a2 -> l1[32] rel
        vfill a3 -> l1[48] rel
        vfill a4 -> l1[64] rel
        vfill a5 -> l1[80] rel
        vsync unpack on=fill
        vunpk v0 <- l1[0] f16
        vunpk v2 <- l1[16] f16
        vunpk v4 <- l1[32] f16
        vunpk v6 <- l1[48] f16
        vunpk v8 <- l1[64] f16
        vunpk v10 <- l1[80] f16
        vadd v12, v0, v2
        vadd v14, v12, v4
        vadd v16, v14, v6
        vadd v18, v16, v8
        vadd v20, v18, v10
        vpack v20 -> l1[96] f16
        vunpk v1 <- l1[8] f16
        vunpk v3 <- l1[24] f16
        vunpk v5 <- l1[40] f16
        vunpk v7 <- l1[56] f16
        vunpk v9 <- l1[72] f16
        vunpk v11 <- l1[88] f16
        vadd v13, v1, v3
        vadd v15, v13, v5
        vadd v17, v15, v7
        vadd v19, v17, v9
        vadd v21, v19, v11
        vpack v21 -> l1[104] f16
        vsync drain on=pack
        vdrain a6 <- l1[96] rel
        vsync fill on=drain
        vsync pack on=drain
    vsync fe on=drain
    halt

fn p6_t4_witness_unsplit.l1(x: mx7a[4, 768] @dram(gm=1, nk=2), w: mx7b[4, 768] @dram(gn=1, nk=2), y: f16[4, 4] @dram(tile=1x1))
    node 0
        send mg[0]
            fill A0 <- x + 0 n=2
            fill B0 <- w + 0 n=2
            gemm 1x1x2 a=A0 b=B0 acc=0
            fill A1 <- x + 256 n=2
            fill B1 <- w + 256 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 512 n=2
            fill B0 <- w + 512 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 768 n=2
            fill B1 <- w + 768 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 1024 n=2
            fill B0 <- w + 1024 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 1280 n=2
            fill B1 <- w + 1280 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 1536 n=2
            fill B0 <- w + 1536 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 1792 n=2
            fill B1 <- w + 1792 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 2048 n=2
            fill B0 <- w + 2048 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 2304 n=2
            fill B1 <- w + 2304 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 2560 n=2
            fill B0 <- w + 2560 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 2816 n=2
            fill B1 <- w + 2816 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
        wait mg[0]
        send mg[0]
            drain y + 0 n=1
        wait mg[0]

fn p6_t4_witness_01.l1(x: mx7a[4, 768] @dram(gm=1, nk=2), w: mx7b[4, 768] @dram(gn=1, nk=2), y1: f16[4, 4] @dram(tile=1x1), seen1: f16[16] @dram, slots: u64[2] @dram)
    node 0
        send mg[0]
            fill A0 <- x + 0 n=2
            fill B0 <- w + 0 n=2
            gemm 1x1x2 a=A0 b=B0 acc=0
            fill A1 <- x + 256 n=2
            fill B1 <- w + 256 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 512 n=2
            fill B0 <- w + 512 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 768 n=2
            fill B1 <- w + 768 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 1024 n=2
            fill B0 <- w + 1024 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 1280 n=2
            fill B1 <- w + 1280 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
        wait mg[0]
        wait slot 1 n=1 consume
        send mg[0]
            drain n=1 to=mesh1.mg[0] buf=2 l1=0
            drain n=4 to=mesh1.mg[0] buf=0 l1=0 count
        wait mg[0]
        wait slot 2 n=1 consume
        r5 = load y1 + 0
        store seen1 + 0 <- r5
        r5 = load y1 + 8
        store seen1 + 8 <- r5
        r5 = load y1 + 16
        store seen1 + 16 <- r5
        r5 = load y1 + 24
        store seen1 + 24 <- r5
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 8 <- r14
    node 1
        send mg[0]
            fill A0 <- x + 1536 n=2
            fill B0 <- w + 1536 n=2
            gemm 1x1x2 a=A0 b=B0 acc=0
            fill A1 <- x + 1792 n=2
            fill B1 <- w + 1792 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 2048 n=2
            fill B0 <- w + 2048 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 2304 n=2
            fill B1 <- w + 2304 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
            fill A0 <- x + 2560 n=2
            fill B0 <- w + 2560 n=2
            gemm 1x1x2 a=A0 b=B0 acc=1
            fill A1 <- x + 2816 n=2
            fill B1 <- w + 2816 n=2
            gemm 1x1x2 a=A1 b=B1 acc=1
        wait mg[0]
        ring mesh=0 slot=1 amount=1
        send mg[0]
            fill A0 recv n=1
        wait mg[0]
        send mg[0]
            drain y1 + 0 n=1
        wait mg[0]
        ring mesh=0 slot=2 amount=1

