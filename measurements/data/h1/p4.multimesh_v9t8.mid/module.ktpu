target ktpu.v9

fn p4_burst_01_n1_d0.l1(count: u64[2] @dram, slots: u64[3] @dram)
    node 0
        wait slot 1 n=1 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=1 slot=2 amount=1
        r9 = set 0
        store count + 0 <- r9
        wait bell 1 n=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        wait slot 2 n=1 consume
        r9 = set 1
        store count + 8 <- r9
        wait bell 0 n=2
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 8 <- r14
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 16 <- r14

