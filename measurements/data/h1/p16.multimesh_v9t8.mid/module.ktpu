fn p16_01_vc_now.l1(x: f16[4096] @dram, y: f16[8192] @dram, seen: f16[8] @dram, slots: u64[2] @dram)
    node 0
        send vc[0]
            run cp(x, y)
        wait vc[0]
        ring mesh=1 slot=1 amount=1
        wait slot 2 n=1 consume
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 0 <- r14
    node 1
        wait slot 1 n=1 consume
        r5 = load y + 0 + 0
        store seen + 0 <- r5
        r5 = load y + 0 + 8184
        store seen + 8 <- r5
        move
            copy w(y + 0, (256, 32)) -> w(y + 8192, (256, 32))
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 8 <- r14

