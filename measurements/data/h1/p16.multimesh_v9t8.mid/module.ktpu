target ktpu.v9

image cp(x, y)
    desc a0 = x walk=(32, 256)
    desc a1 = y walk=(32, 256)
    vfill a0 -> l1[0]
    vsync drain on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

image load(n, x)
    desc a0 = x walk=(32, 64)
    ainc a0 += 2048
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync fe on=fill
    halt

fn p16_00_vc_now.l1(x: f16[4096] @dram, y: f16[8192] @dram, seen: f16[8] @dram, slots: u64[0] @dram)
    node 0
        send vc[0]
            run cp(x, y)
        wait vc[0]
        r5 = load y + 0 + 0
        store seen + 0 <- r5
        r5 = load y + 0 + 8184
        store seen + 8 <- r5
        move
            copy w(y + 0, (256, 32)) -> w(y + 8192, (256, 32))

