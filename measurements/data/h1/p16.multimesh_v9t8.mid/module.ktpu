fn p16_00_mg_now.l1(x: mx7a[64, 64] @dram(gm=16, nk=2), w: mx7b[64, 64] @dram(gn=16, nk=2), y: f16[8192] @dram, seen: f16[8] @dram, slots: u64[0] @dram)
    node 0
        send mg[0]
            fill A0 <- x n=32
            fill B0 <- w n=32
            gemm 16x16x2 a=A0 b=B0 acc=0
            drain y n=256
        wait mg[0]
        r5 = load y + 0 + 0
        store seen + 0 <- r5
        r5 = load y + 0 + 8184
        store seen + 8 <- r5
        move
            copy w(y + 0, (256, 32)) -> w(y + 8192, (256, 32))

