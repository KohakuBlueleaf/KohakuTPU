fn p18_shards_s1_r1.l1(x: f16[2048] @dram, y: f16[2048] @dram, z: f16[2048] @dram, seen: u64[6] @dram, slots: u64[8] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        move
            copy w(x + 0, (32, 32)) -> w(y + 0, (32, 32))
        wait slot 5 n=1 consume
        r5 = load y + 1024
        store seen + 0 <- r5
        r5 = load y + 2040
        store seen + 8 <- r5
        wait slot 6 n=1 consume
        r5 = load y + 2048
        store seen + 16 <- r5
        r5 = load y + 3064
        store seen + 24 <- r5
        wait slot 7 n=1 consume
        r5 = load y + 3072
        store seen + 32 <- r5
        r5 = load y + 4088
        store seen + 40 <- r5
        move
            copy w(y, (128, 32)) -> w(z, (128, 32))
        wait slot 2 n=3 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 8 <- r14
        ctrl il_select <- 5
        r14 = ctrl sig
        store slots + 16 <- r14
        ctrl il_select <- 6
        r14 = ctrl sig
        store slots + 24 <- r14
        ctrl il_select <- 7
        r14 = ctrl sig
        store slots + 32 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        move
            copy w(x + 1024, (32, 32)) -> w(y + 1024, (32, 32))
        ring mesh=0 slot=5 amount=1
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 40 <- r14
    node 2
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        move
            copy w(x + 2048, (32, 32)) -> w(y + 2048, (32, 32))
        ring mesh=0 slot=6 amount=1
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 48 <- r14
    node 3
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        move
            copy w(x + 3072, (32, 32)) -> w(y + 3072, (32, 32))
        ring mesh=0 slot=7 amount=1
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 56 <- r14

