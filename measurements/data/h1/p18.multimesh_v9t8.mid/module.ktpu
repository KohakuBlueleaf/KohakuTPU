fn p18_ready_01_s4_r8_now.l1(x: f16[2048] @dram, y: f16[2048] @dram, seen: u64[8] @dram, slots: u64[4] @dram)
    node 0
        r1 = set 0
        r2 = set 8
        label rep
        wait slot 1 n=1 consume
        ring mesh=1 slot=1 amount=1
        wait slot 3 n=1 consume
        send vc[0]
            run put1(32, 0, x + 0)
        wait vc[0]
        wait slot 3 n=1 consume
        send vc[0]
            run put1(32, 0, x + 1024)
        wait vc[0]
        wait slot 3 n=1 consume
        send vc[0]
