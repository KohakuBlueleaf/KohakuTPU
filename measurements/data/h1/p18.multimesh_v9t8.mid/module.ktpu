target ktpu.v9

image chunk(x, y)
    desc a0 = x walk=(32, 32)
    desc a1 = y walk=(32, 32)
    vfill a0 -> l1[64]
    vsync drain on=fill
    vdrain a1 <- l1[64]
    vsync fe on=drain
    halt

image take(n, at, y)
    desc a0 = y walk=(32, n)
    vwait drain rx n=n
    vdrain a0 <- l1[at]
    halt

image put0(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh0.vc[0], count=1, fin=mesh0.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put1(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh1.vc[0], count=1, fin=mesh1.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put2(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh2.vc[0], count=1, fin=mesh2.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

image put3(n, at, x)
    desc a0 = x walk=(32, n)
    desc a1 = peer(at, ack=mesh3.vc[0], count=1, fin=mesh3.vc[0]) walk=(32, n)
    vfill a0 -> l1[at]
    vsync drain on=fill
    vdrain a1 <- l1[at] to=(0, 1)
    vsync fe on=drain
    halt

fn p18_empty_r1.l1(unused: u64[4] @dram, slots: u64[5] @dram)
    node 0
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        wait slot 2 n=3 consume
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 8 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 16 <- r14
    node 2
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 24 <- r14
    node 3
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ring mesh=0 slot=2 amount=1
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 32 <- r14

fn p18_empty_r8.l1(unused: u64[4] @dram, slots: u64[5] @dram)
    node 0
        r1 = set 0
        r2 = set 8
        label rep
        wait slot 1 n=3 consume
        ring mesh=1 slot=1 amount=1
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        wait slot 2 n=3 consume
        r1 = add r1, 1
        goto rep if r1 < r2
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 8 <- r14
    node 1
        r1 = set 0
        r2 = set 8
        label rep
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ring mesh=0 slot=2 amount=1
        r1 = add r1, 1
        goto rep if r1 < r2
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 16 <- r14
    node 2
        r1 = set 0
        r2 = set 8
        label rep
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ring mesh=0 slot=2 amount=1
        r1 = add r1, 1
        goto rep if r1 < r2
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 24 <- r14
    node 3
        r1 = set 0
        r2 = set 8
        label rep
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        ring mesh=0 slot=2 amount=1
        r1 = add r1, 1
        goto rep if r1 < r2
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 32 <- r14

