target ktpu.v9

image load(n, x)
    desc a0 = x walk=(32, 64)
    ainc a0 += 2048
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync fe on=fill
    halt

fn p1_01_fenced_slot_idle_k1.l1(count: u64[2] @dram, slots: u64[3] @dram)
    node 0
        wait slot 1 n=1 consume
        r1 = set 0
        r2 = set 1
        label trip
        ring mesh=1 slot=2 amount=1
        wait slot 2 n=1 consume
        r1 = add r1, 1
        goto trip if r1 < r2
        store count + 0 <- r1
        wait bell 1 n=2
        ctrl il_select <- 1
        r14 = ctrl sig
        store slots + 0 <- r14
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 8 <- r14
    node 1
        ring mesh=0 slot=1 amount=1
        r1 = set 0
        r2 = set 1
        label trip
        wait slot 2 n=1 consume
        ring mesh=0 slot=2 amount=1
        r1 = add r1, 1
        goto trip if r1 < r2
        store count + 8 <- r1
        wait bell 0 n=1
        ctrl il_select <- 2
        r14 = ctrl sig
        store slots + 16 <- r14

