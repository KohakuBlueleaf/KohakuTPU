target ktpu.v9

image take(n, at, y)
    desc a0 = y walk=(32, n)
    vwait drain rx n=n
    vdrain a0 <- l1[at]
    halt

fn p5_1to0_4k.l1(x: mx7a[256, 256] @dram(gm=64, nk=2), w: mx7b[256, 256] @dram(gn=64, nk=2), y: f16[2048] @dram)
    node 0
        wait slot 1 n=1 consume
        ring mesh=1 slot=1 amount=1
        send vc[0]
            run take(128, 0, y + 0)
        wait vc[0]
        ring mesh=1 slot=2 amount=1
    node 1
        send mg[0]
            for c in 0..4
                fill A{c % 2} <- x + c*16K n=128
                fill B{c % 2} <- w + c*16K n=128
                gemm 64x64x2 a=A{c % 2} b=B{c % 2} acc=(c > 0)
        wait mg[0]
        ring mesh=0 slot=1 amount=1
        wait slot 1 n=1 consume
        send mg[0]
            drain n=128 to=mesh0.vc[0] buf=0 l1=0 count
        wait mg[0]
        wait slot 2 n=1 consume

fn p5_1to0_16k.l1(x: mx7a[256, 256] @dram(gm=64, nk=2), w: mx7b[256, 256] @dram(gn=64, nk=2), y: f16[8192] @dram)
    node 0
