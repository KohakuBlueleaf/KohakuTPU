    node 1
        send mg[0]
            for c in 0..4
                fill A{c % 2} <- x + c*16K n=128
                fill B{c % 2} <- w + c*16K n=128
                gemm 64x64x2 a=A{c % 2} b=B{c % 2} acc=(c > 0)
        wait mg[0]
        wait slot 1 n=2 consume
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send mg[0]
            drain n=128 to=mesh2.vc[0] buf=0 l1=0 count
        wait mg[0]
        wait slot 2 n=1 consume
    node 2
        ring mesh=1 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
            run take(128, 0, y + 0)
        send vc[1]
            run take(128, 0, y + 4096)
        wait vc[0]
        ring mesh=1 slot=2 amount=1
        wait vc[1]
        ring mesh=3 slot=2 amount=1
    node 3
        send mg[0]
            for c in 0..4
                fill A{c % 2} <- x + c*16K n=128
                fill B{c % 2} <- w + c*16K n=128
                gemm 64x64x2 a=A{c % 2} b=B{c % 2} acc=(c > 0)
        wait mg[0]
        ring mesh=1 slot=1 amount=1
        wait slot 1 n=1 consume
        send mg[0]
            drain n=128 to=mesh2.vc[1] buf=0 l1=0 count
        wait mg[0]
        wait slot 2 n=1 consume

