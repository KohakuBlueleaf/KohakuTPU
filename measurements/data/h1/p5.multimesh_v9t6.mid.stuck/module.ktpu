        ring mesh=1 slot=1 amount=1
        wait slot 1 n=1 consume
        send mg[0]
            drain n=128 to=mesh3.vc[1] buf=0 l1=0 count
        wait mg[0]
        wait slot 2 n=1 consume
    node 3
        ring mesh=1 slot=1 amount=1
        wait slot 1 n=1 consume
        send vc[0]
