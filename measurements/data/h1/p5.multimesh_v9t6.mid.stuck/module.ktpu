fn p5_12to3_1024k.l1(x: mx7a[256, 256] @dram(gm=64, nk=2), w: mx7b[256, 256] @dram(gn=64, nk=2), y: f16[1048576] @dram)
    node 1
        send mg[0]
            for c in 0..4
                fill A{c % 2} <- x + c*16K n=128
                fill B{c % 2} <- w + c*16K n=128
                gemm 64x64x2 a=A{c % 2} b=B{c % 2} acc=(c > 0)
        wait mg[0]
        wait slot 1 n=2 consume
        ring mesh=2 slot=1 amount=1
        ring mesh=3 slot=1 amount=1
        send mg[0]
            drain n=256 to=mesh3.vc[0] buf=0 l1=0 count
