fn quant_4c257bc223.l1(p_x: f16[23640, 16] @dram, q: mx7b[2240, 64] @dram(gn=56, nk=2), __mx7_status_0: f16[128] @dram)
    send vc[0]
        run quant_4c257bc223.read_clear_0()
    send vc[1]
        run quant_4c257bc223.read_clear_0()
    wait vc[0]
    wait vc[1]
    send vc[0]
        run quant_4c257bc223.read_pack_0_0(p_x+0, q+12800, p_x+0, q+84480, 1)
    send vc[1]
        run quant_4c257bc223.read_pack_0_2(p_x+554752, q+66560, q+66688, q+66816, q+66944, 6)
    send vc[0]
        run quant_4c257bc223.read_pack_0_1(p_x+738560, q+12288, q+12416, q+12544, q+12672, 10)
    send vc[1]
        run quant_4c257bc223.read_pack_0_2(p_x+1920, q+71680, q+71808, q+71936, q+72064, 24)
    send vc[0]
        run quant_4c257bc223.read_pack_0_2(p_x+1280, q+0, q+128, q+256, q+384, 24)
    send vc[1]
