target ktpu.v9

fn mm_3aec19bc42.l2(a: mx7a[2000, 64] @dram(gm=50, nk=2), b: mx7b[2240, 64] @dram(gn=56, nk=2), out: f16[2000, 224] @dram)
    h1 = buffer  : f16[800, 224] @stage(tile=50x56)
    for k1 in 0..5 pipe=2
        par u1 in 0..2 on mg[u1]
            for k2 in 0..1
                acc1 = zero  : f32[200, 224] @acc
                for k3 in 0..1
                    a1 = fill a[k1*400 + u1*200 + k2*400 : +200, k3*64 : +64]  : mx7a[200, 64] @A
                    b1 = fill b[k1*448 + u1*224 + k2*448 : +224, k3*64 : +64]  : mx7b[224, 64] @B
                    acc1 = gemm a1, b1, acc1    : f32[200, 224] @acc
                drain acc1 -> h1[(k1 % 2)*400 + u1*200 + k2*400 : +200, 0 : +224]
        par c1 in 0..2 on vc[c1]
            for t1 in 0..25
                xl1 = load h1[(k1 % 2)*400 + c1*200 + t1*8 : +8, 0 : +224]  : f16[8, 224] @l1(gt4)
                v1 = unpack xl1                 : f32[8, 224] @reg(gt4)
                e1 = mul v1, 0.125              : f32[8, 224] @reg(gt4)
                p1 = pack e1                    : f16[8, 224] @l1(gt4)
                store out[k1*400 + c1*200 + t1*8 : +8, 0 : +224] <- p1
