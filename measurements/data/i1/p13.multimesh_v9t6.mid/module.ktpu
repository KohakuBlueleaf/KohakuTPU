target ktpu.v9

image cp(n, s, y)
    desc a0 = s walk=(32, n)
    desc a1 = y walk=(32, n)
    vfill a0 -> l1[0]
    vsync drain on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

image rd(n, src, v)
    desc a0 = src walk=((32, 4), (512, 64))
    desc a1 = v walk=(32, 256)
    ainc a0 += 32768
    seti s0 = n
    loop s0
        vfill a0 -> l1[0] rel
        vsync fe on=fill
    vdrain a1 <- l1[0]
    vsync fe on=drain
    halt

image wr(n, x, dst)
    desc a0 = x walk=(32, 256)
    desc a1 = dst walk=((32, 4), (512, 64))
    ainc a1 += 32768
    vfill a0 -> l1[0]
    vsync drain on=fill
    seti s0 = n
    loop s0
        vdrain a1 <- l1[0] rel
    vsync fe on=drain
    halt

image take_256_0(y)
    desc a0 = y walk=(32, 256)
    vwait drain rx n=256
    vdrain a0 <- l1[0]
    vsync fe on=drain
    halt

image take_128_0(y)
    desc a0 = y walk=(32, 128)
    vwait drain rx n=128
    vdrain a0 <- l1[0]
    vsync fe on=drain
    halt

image take_128_128(y)
    desc a0 = y walk=(32, 128)
    vwait drain rx n=128
    vdrain a0 <- l1[128]
    vsync fe on=drain
    halt

fn p13_direct_mg1_buf1_own.l1(x: mx7a[64, 256] @dram(gm=16, nk=2), w: mx7b[256, 256] @dram(gn=16, nk=2), y: f16[64, 256] @dram(tile=16x16))
    node 0
        send mg[0]
            fill A0 <- x + 0 n=32
            fill B0 <- w + 0 n=32
            gemm 16x16x2 a=A0 b=B0 acc=0
            fill A1 <- x + 4096 n=32
            fill B1 <- w + 4096 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
            fill A0 <- x + 8192 n=32
            fill B0 <- w + 8192 n=32
            gemm 16x16x2 a=A0 b=B0 acc=1
            fill A1 <- x + 12288 n=32
            fill B1 <- w + 12288 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        send mg[0]
            drain n=256 to=vc[0] l1=0 count
        send vc[0]
            run take_256_0(y + 0)
        v0_1 = mark vc[0]
        send mg[0]
            fill A0 <- x + 0 n=32
            fill B0 <- w + 16384 n=32
            gemm 16x16x2 a=A0 b=B0 acc=0
            fill A1 <- x + 4096 n=32
            fill B1 <- w + 20480 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
            fill A0 <- x + 8192 n=32
            fill B0 <- w + 24576 n=32
            gemm 16x16x2 a=A0 b=B0 acc=1
            fill A1 <- x + 12288 n=32
            fill B1 <- w + 28672 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait vc[0] upto=v0_1
        send mg[0]
            drain n=256 to=vc[0] l1=0 count
        send vc[0]
            run take_256_0(y + 8192)
        v0_2 = mark vc[0]
        send mg[0]
            fill A0 <- x + 0 n=32
            fill B0 <- w + 32768 n=32
            gemm 16x16x2 a=A0 b=B0 acc=0
            fill A1 <- x + 4096 n=32
            fill B1 <- w + 36864 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
            fill A0 <- x + 8192 n=32
            fill B0 <- w + 40960 n=32
            gemm 16x16x2 a=A0 b=B0 acc=1
            fill A1 <- x + 12288 n=32
            fill B1 <- w + 45056 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait vc[0] upto=v0_2
        send mg[0]
            drain n=256 to=vc[0] l1=0 count
        send vc[0]
            run take_256_0(y + 16384)
        v0_3 = mark vc[0]
        send mg[0]
            fill A0 <- x + 0 n=32
            fill B0 <- w + 49152 n=32
            gemm 16x16x2 a=A0 b=B0 acc=0
            fill A1 <- x + 4096 n=32
            fill B1 <- w + 53248 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
            fill A0 <- x + 8192 n=32
            fill B0 <- w + 57344 n=32
            gemm 16x16x2 a=A0 b=B0 acc=1
            fill A1 <- x + 12288 n=32
            fill B1 <- w + 61440 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait vc[0] upto=v0_3
        send mg[0]
            drain n=256 to=vc[0] l1=0 count
        send vc[0]
            run take_256_0(y + 24576)
        v0_4 = mark vc[0]
        barrier

