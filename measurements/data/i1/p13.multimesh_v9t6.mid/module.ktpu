        t1 = mark mg[1]
        send mg[1]
            fill A1 <- x + 12288 n=32 peers=(mg[0])
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait mg[1] upto=t1
        send mg[0]
            fill A1 <- x + 12288 n=32 peers=(mg[1])
            fill B1 <- w + 12288 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        send mg[0]
            drain n=256 to=vc[0] l1=0 count
        send vc[0]
            run take_256_0(y + 0)
        v0_1 = mark vc[0]
        send mg[1]
            drain n=256 to=vc[1] l1=0 count
        send vc[1]
            run take_256_0(y + 16384)
        v1_1 = mark vc[1]
        send mg[1]
            fill B0 <- w + 49152 n=32
        t1 = mark mg[1]
        send mg[1]
            fill A0 <- x + 0 n=32 peers=(mg[0])
            gemm 16x16x2 a=A0 b=B0 acc=0
        wait mg[1] upto=t1
        send mg[0]
            fill A0 <- x + 0 n=32 peers=(mg[1])
            fill B0 <- w + 16384 n=32
            gemm 16x16x2 a=A0 b=B0 acc=0
        send mg[1]
            fill B1 <- w + 53248 n=32
        t1 = mark mg[1]
        send mg[1]
            fill A1 <- x + 4096 n=32 peers=(mg[0])
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait mg[1] upto=t1
        send mg[0]
            fill A1 <- x + 4096 n=32 peers=(mg[1])
            fill B1 <- w + 20480 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        send mg[1]
            fill B0 <- w + 57344 n=32
        t1 = mark mg[1]
        send mg[1]
            fill A0 <- x + 8192 n=32 peers=(mg[0])
            gemm 16x16x2 a=A0 b=B0 acc=1
        wait mg[1] upto=t1
        send mg[0]
            fill A0 <- x + 8192 n=32 peers=(mg[1])
            fill B0 <- w + 24576 n=32
            gemm 16x16x2 a=A0 b=B0 acc=1
        send mg[1]
            fill B1 <- w + 61440 n=32
        t1 = mark mg[1]
        send mg[1]
            fill A1 <- x + 12288 n=32 peers=(mg[0])
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait mg[1] upto=t1
        send mg[0]
            fill A1 <- x + 12288 n=32 peers=(mg[1])
            fill B1 <- w + 28672 n=32
            gemm 16x16x2 a=A1 b=B1 acc=1
        wait vc[0] upto=v0_1
        send mg[0]
            drain n=256 to=vc[0] l1=0 count
        send vc[0]
            run take_256_0(y + 8192)
        v0_2 = mark vc[0]
        wait vc[1] upto=v1_1
        send mg[1]
            drain n=256 to=vc[1] l1=0 count
        send vc[1]
