fn p13_direct_mg2_buf1_shared.l1(x: mx7a[64, 256] @dram(gm=16, nk=2), w: mx7b[256, 256] @dram(gn=16, nk=2), y: f16[64, 256] @dram(tile=16x16))
    node 0
        send mg[1]
            fill B0 <- w + 32768 n=32
        t1 = mark mg[1]
        send mg[1]
            fill A0 <- x + 0 n=32 peers=(mg[0])
            gemm 16x16x2 a=A0 b=B0 acc=0
        wait mg[1] upto=t1
        send mg[0]
            fill A0 <- x + 0 n=32 peers=(mg[1])
